# Immutable scalars can be shared safely; copying them is a no-op.
var _IMMUTABLE = Set(["None", "Bool", "Integer", "Float", "String", "Bytes"])

# Pure Kirito has no generic way to enumerate/set an instance's attributes, so a class instance (or a
# native value object like Matrix/Tensor/DateTime) is copied via the serialize graph codec, which
# copies by attributes / the _getstate_/_setstate_ protocol and preserves shared refs + cycles. This
# is necessarily a DEEP, independent copy. A value that can't be serialized (a live regex/socket/file
# handle) is not copyable and throws, matching native rather than silently aliasing the original.
var _copyViaSerde = Function(obj):
    var serialize = import("serialize")
    try:
        return serialize.loads(serialize.dumps(obj))
    catch as e:
        throw "cannot copy an unserializable value"

var copy = Function(obj):
    var t = type(obj)
    if t == "List":
        return obj.copy()
    if t == "Dict":
        return obj.copy()
    if t == "Set":
        return obj.copy()
    if t in _IMMUTABLE:
        return obj
    return _copyViaSerde(obj)        # user instance / native value object: independent (deep) copy

# A value that is shared (not deep-copied) as a leaf: immutable scalars, and functions/modules (native
# deepcopy aliases callables — e.g. a defaultdict's factory — rather than cloning them).
var _isSharedLeaf = Function(t):
    if t in _IMMUTABLE:
        return True
    return t == "Function" or t == "Module"

var deepcopy = Function(obj):
    var t = type(obj)
    if _isSharedLeaf(t):
        return obj
    # ONE iterative, cycle-safe graph pass over containers AND plain user instances, keyed by id, so a
    # value reachable via both a container slot and an instance attribute is copied exactly once (shared
    # identity + cycles preserved across the container<->instance boundary). Instances that expose a
    # _getstate_ (or native value objects with no introspectable attrs) are copied whole via the serde
    # codec, which is itself ref-aware.
    var memo = {}
    var order = []
    var stack = [obj]
    while len(stack) > 0:
        var cur = stack.pop()
        var cid = id(cur)
        if cid in memo:
            continue
        var ct = type(cur)
        if _isSharedLeaf(ct):
            continue                      # leaf: mapped() returns it unchanged
        if ct == "List":
            memo[cid] = []
        elif ct == "Dict":
            memo[cid] = {}
        elif ct == "Set":
            memo[cid] = Set()
        elif __instattrs__(cur) != None and not __hasmethod__(cur, "_getstate_"):
            memo[cid] = __instnew__(__instname__(cur), {})   # plain instance: shell + descend into attrs
        else:
            memo[cid] = _copyViaSerde(cur)  # native value / _getstate_ instance: whole ref-aware copy
            continue
        order.append(cur)
        if ct == "Dict":
            for pair in cur.items():
                stack.append(pair[0])
                stack.append(pair[1])
        elif ct == "List" or ct == "Set":
            for x in cur:
                stack.append(x)
        else:
            var a0 = __instattrs__(cur)
            for ak in a0:
                stack.append(a0[ak])
    var mapped = Function(x):
        var xid = id(x)
        return memo[xid] if xid in memo else x
    for cur in order:
        var ct = type(cur)
        var shell = memo[id(cur)]
        if ct == "List":
            for x in cur:
                shell.append(mapped(x))
        elif ct == "Set":
            for x in cur:
                shell.add(mapped(x))
        elif ct == "Dict":
            for pair in cur.items():
                shell[mapped(pair[0])] = mapped(pair[1])
        else:
            var live = __instattrs__(shell)
            var a1 = __instattrs__(cur)
            for ak in a1:
                live[ak] = mapped(a1[ak])
    return memo[id(obj)]
