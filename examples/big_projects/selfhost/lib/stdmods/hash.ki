# The `hash` module in pure Kirito: standards-conformant md5 and sha256 (byte-exact digests).
# 32-bit arithmetic is done with mod 2^32 and pow-of-two multiply/divide; the logical ops are
# computed bitwise. Inputs are treated as byte strings (each character's ord is one byte).

var _M32 = 4294967296

var _pow2 = Function(n):
    var r = 1
    var i = 0
    while i < n:
        r = r * 2
        i = i + 1
    return r

# Nibble (4-bit) lookup tables make the 32-bit logical ops 8 table reads instead of 32 bit-tests —
# essential for tractable speed under the self-hosted (doubly-interpreted) runtime.
var _NAND = []
var _NOR = []
var _NXOR = []
var _na = 0
while _na < 16:
    var _nb = 0
    while _nb < 16:
        var aa = _na
        var bb = _nb
        var ra = 0
        var ro = 0
        var rx = 0
        var bit = 1
        var bi = 0
        while bi < 4:
            var x = aa % 2
            var y = bb % 2
            if x == 1 and y == 1:
                ra = ra + bit
            if x == 1 or y == 1:
                ro = ro + bit
            if x != y:
                rx = rx + bit
            bit = bit * 2
            aa = aa // 2
            bb = bb // 2
            bi = bi + 1
        _NAND.append(ra)
        _NOR.append(ro)
        _NXOR.append(rx)
        _nb = _nb + 1
    _na = _na + 1

var _op32 = Function(a, b, tbl):
    var res = 0
    var pw = 1
    var i = 0
    while i < 8:
        res = res + tbl[((a // pw) % 16) * 16 + ((b // pw) % 16)] * pw
        pw = pw * 16
        i = i + 1
    return res

var _and = Function(a, b):
    return _op32(a, b, _NAND)
var _or = Function(a, b):
    return _op32(a, b, _NOR)
var _xor = Function(a, b):
    return _op32(a, b, _NXOR)
var _not = Function(a):
    return _M32 - 1 - a
var _add = Function(a, b):
    return (a + b) % _M32
var _shr = Function(x, n):
    return x // _pow2(n)
var _rotr = Function(x, n):
    return (x // _pow2(n) + x * _pow2(32 - n)) % _M32
var _rotl = Function(x, n):
    return (x * _pow2(n) + x // _pow2(32 - n)) % _M32

var _HEX = "0123456789abcdef"
var _hex8 = Function(x):
    # 32-bit value -> 8 lowercase hex digits, big-endian
    var out = ""
    var i = 7
    while i >= 0:
        out = out + _HEX[(x // _pow2(i * 4)) % 16]
        i = i - 1
    return out

var _bytesOf = Function(s):
    # Hash the raw bytes: a Bytes yields its bytes directly; a String is its UTF-8 encoding (so the
    # self-host matches the real byte-transparent String, and hash(s) == hash(s.encode())). Anything
    # else has no .encode and throws, which is the intended "wrong type" rejection.
    if type(s) == "Bytes":
        return List(s)
    return List(s.encode())

# --- md5 -----------------------------------------------------------------------------------------
var _MD5_S = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
              5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
              4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
              6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
var _MD5_K = [3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426,
              2821735955, 4249261313, 1770035416, 2336552879, 4294925233, 2304563134,
              1804603682, 4254626195, 2792965006, 1236535329, 4129170786, 3225465664,
              643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448,
              568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512,
              1735328473, 2368359562, 4294588738, 2272392833, 1839030562, 4259657740,
              2763975236, 1272893353, 4139469664, 3200236656, 681279174, 3936430074,
              3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645,
              4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690,
              4293915773, 2240044497, 1873313359, 4264355552, 2734768916, 1309151649,
              4149444226, 3174756917, 718787259, 3951481745]

var _le32 = Function(bytes, i):
    return bytes[i] + bytes[i + 1] * 256 + bytes[i + 2] * 65536 + bytes[i + 3] * 16777216

var _hexLE = Function(x):
    # 32-bit value -> 8 hex digits in little-endian byte order (md5 output convention)
    var out = ""
    var b = 0
    while b < 4:
        var byte = (x // _pow2(b * 8)) % 256
        out = out + _HEX[byte // 16] + _HEX[byte % 16]
        b = b + 1
    return out

var md5 = Function(data):
    var msg = _bytesOf(data)
    var origLenBits = len(msg) * 8
    msg.append(128)
    while len(msg) % 64 != 56:
        msg.append(0)
    var lb = 0
    while lb < 8:
        msg.append((origLenBits // _pow2(lb * 8)) % 256)
        lb = lb + 1
    var a0 = 1732584193
    var b0 = 4023233417
    var c0 = 2562383102
    var d0 = 271733878
    var chunk = 0
    while chunk < len(msg):
        var M = []
        var w = 0
        while w < 16:
            M.append(_le32(msg, chunk + w * 4))
            w = w + 1
        var A = a0
        var B = b0
        var C = c0
        var D = d0
        var i = 0
        while i < 64:
            var F = 0
            var g = 0
            if i < 16:
                F = _or(_and(B, C), _and(_not(B), D))
                g = i
            elif i < 32:
                F = _or(_and(D, B), _and(_not(D), C))
                g = (5 * i + 1) % 16
            elif i < 48:
                F = _xor(_xor(B, C), D)
                g = (3 * i + 5) % 16
            else:
                F = _xor(C, _or(B, _not(D)))
                g = (7 * i) % 16
            F = _add(_add(F, A), _add(_MD5_K[i], M[g]))
            A = D
            D = C
            C = B
            B = _add(B, _rotl(F, _MD5_S[i]))
            i = i + 1
        a0 = _add(a0, A)
        b0 = _add(b0, B)
        c0 = _add(c0, C)
        d0 = _add(d0, D)
        chunk = chunk + 64
    return _hexLE(a0) + _hexLE(b0) + _hexLE(c0) + _hexLE(d0)

# --- sha1 ----------------------------------------------------------------------------------------
var sha1 = Function(data):
    var msg = _bytesOf(data)
    var origLenBits = len(msg) * 8
    msg.append(128)
    while len(msg) % 64 != 56:
        msg.append(0)
    var lb = 7
    while lb >= 0:
        msg.append((origLenBits // _pow2(lb * 8)) % 256)
        lb = lb - 1
    var h0 = 1732584193
    var h1 = 4023233417
    var h2 = 2562383102
    var h3 = 271733878
    var h4 = 3285377520
    var chunk = 0
    while chunk < len(msg):
        var w = []
        var t = 0
        while t < 16:
            w.append(_be32(msg, chunk + t * 4))
            t = t + 1
        t = 16
        while t < 80:
            w.append(_rotl(_xor(_xor(w[t - 3], w[t - 8]), _xor(w[t - 14], w[t - 16])), 1))
            t = t + 1
        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var i = 0
        while i < 80:
            var f = 0
            var k = 0
            if i < 20:
                f = _or(_and(b, c), _and(_not(b), d))
                k = 1518500249
            elif i < 40:
                f = _xor(_xor(b, c), d)
                k = 1859775393
            elif i < 60:
                f = _or(_or(_and(b, c), _and(b, d)), _and(c, d))
                k = 2400959708
            else:
                f = _xor(_xor(b, c), d)
                k = 3395469782
            var tmp = _add(_add(_rotl(a, 5), f), _add(_add(e, k), w[i]))
            e = d
            d = c
            c = _rotl(b, 30)
            b = a
            a = tmp
            i = i + 1
        h0 = _add(h0, a)
        h1 = _add(h1, b)
        h2 = _add(h2, c)
        h3 = _add(h3, d)
        h4 = _add(h4, e)
        chunk = chunk + 64
    return _hex8(h0) + _hex8(h1) + _hex8(h2) + _hex8(h3) + _hex8(h4)

# --- sha256 --------------------------------------------------------------------------------------
var _SHA_K = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993,
              2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987,
              1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774,
              264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
              2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711,
              113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291,
              1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411,
              3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
              430227734, 506948616, 659060556, 883997877, 958139571, 1322822218,
              1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424,
              2428436474, 2756734187, 3204031479, 3329325298]

var _be32 = Function(bytes, i):
    return bytes[i] * 16777216 + bytes[i + 1] * 65536 + bytes[i + 2] * 256 + bytes[i + 3]

var sha256 = Function(data):
    var msg = _bytesOf(data)
    var origLenBits = len(msg) * 8
    msg.append(128)
    while len(msg) % 64 != 56:
        msg.append(0)
    var lb = 7
    while lb >= 0:
        msg.append((origLenBits // _pow2(lb * 8)) % 256)
        lb = lb - 1
    var h = [1779033703, 3144134277, 1013904242, 2773480762,
             1359893119, 2600822924, 528734635, 1541459225]
    var chunk = 0
    while chunk < len(msg):
        var w = []
        var t = 0
        while t < 16:
            w.append(_be32(msg, chunk + t * 4))
            t = t + 1
        t = 16
        while t < 64:
            var s0 = _xor(_xor(_rotr(w[t - 15], 7), _rotr(w[t - 15], 18)), _shr(w[t - 15], 3))
            var s1 = _xor(_xor(_rotr(w[t - 2], 17), _rotr(w[t - 2], 19)), _shr(w[t - 2], 10))
            w.append(_add(_add(w[t - 16], s0), _add(w[t - 7], s1)))
            t = t + 1
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        var i = 0
        while i < 64:
            var S1 = _xor(_xor(_rotr(e, 6), _rotr(e, 11)), _rotr(e, 25))
            var ch = _xor(_and(e, f), _and(_not(e), g))
            var temp1 = _add(_add(hh, S1), _add(ch, _add(_SHA_K[i], w[i])))
            var S0 = _xor(_xor(_rotr(a, 2), _rotr(a, 13)), _rotr(a, 22))
            var maj = _xor(_xor(_and(a, b), _and(a, c)), _and(b, c))
            var temp2 = _add(S0, maj)
            hh = g
            g = f
            f = e
            e = _add(d, temp1)
            d = c
            c = b
            b = a
            a = _add(temp1, temp2)
            i = i + 1
        h[0] = _add(h[0], a)
        h[1] = _add(h[1], b)
        h[2] = _add(h[2], c)
        h[3] = _add(h[3], d)
        h[4] = _add(h[4], e)
        h[5] = _add(h[5], f)
        h[6] = _add(h[6], g)
        h[7] = _add(h[7], hh)
        chunk = chunk + 64
    var out = ""
    for v in h:
        out = out + _hex8(v)
    return out

# --- SHA-512 / SHA-384 (64-bit words) ------------------------------------------------------------
# These use native 64-bit integer bitwise ops (bitand/bitor/bitxor/shl/shr) rather than the mod-2^32
# helpers above; addition wraps mod 2^64 like the reference. shr is ARITHMETIC, so a logical right
# shift masks off the sign-extended high bits.
var _shrL = Function(x, n):
    return bitand(shr(x, n), shl(1, 64 - n) - 1)
var _rotr64 = Function(x, n):
    return bitor(_shrL(x, n), shl(x, 64 - n))
var _be64 = Function(bytes, i):
    var v = 0
    var j = 0
    while j < 8:
        v = bitor(shl(v, 8), bytes[i + j])
        j = j + 1
    return v
var _hex16 = Function(x):
    # 64-bit value -> 16 lowercase hex digits, big-endian (bitand of an arithmetic shift keeps the
    # correct low nibble regardless of sign).
    var out = ""
    var i = 15
    while i >= 0:
        out = out + _HEX[bitand(shr(x, i * 4), 15)]
        i = i - 1
    return out

var _SHA512_K = [0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
                 0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
                 0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
                 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
                 0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
                 0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
                 0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
                 0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
                 0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
                 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
                 0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
                 0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
                 0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
                 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
                 0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
                 0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
                 0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
                 0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
                 0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
                 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817]

# core compression over 128-byte blocks; `h` is the 8-word initial state (caller supplies 512 vs 384)
var _sha512core = Function(data, h0):
    var msg = _bytesOf(data)
    var origLenBits = len(msg) * 8
    msg.append(128)
    while len(msg) % 128 != 112:
        msg.append(0)
    # 128-bit big-endian length: the high 8 bytes are 0 for any realistic message (and _pow2 would
    # overflow to 0 past 2^63); only the low 8 bytes carry the bit count.
    var lb = 8
    while lb > 0:
        msg.append(0)
        lb = lb - 1
    lb = 7
    while lb >= 0:
        msg.append((origLenBits // _pow2(lb * 8)) % 256)
        lb = lb - 1
    var h = List(h0)
    var chunk = 0
    while chunk < len(msg):
        var w = []
        var t = 0
        while t < 16:
            w.append(_be64(msg, chunk + t * 8))
            t = t + 1
        t = 16
        while t < 80:
            var x15 = w[t - 15]
            var x2 = w[t - 2]
            var s0 = bitxor(bitxor(_rotr64(x15, 1), _rotr64(x15, 8)), _shrL(x15, 7))
            var s1 = bitxor(bitxor(_rotr64(x2, 19), _rotr64(x2, 61)), _shrL(x2, 6))
            w.append(w[t - 16] + s0 + w[t - 7] + s1)
            t = t + 1
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        var i = 0
        while i < 80:
            var S1 = bitxor(bitxor(_rotr64(e, 14), _rotr64(e, 18)), _rotr64(e, 41))
            var ch = bitxor(bitand(e, f), bitand(bitnot(e), g))
            var temp1 = hh + S1 + ch + _SHA512_K[i] + w[i]
            var S0 = bitxor(bitxor(_rotr64(a, 28), _rotr64(a, 34)), _rotr64(a, 39))
            var maj = bitxor(bitxor(bitand(a, b), bitand(a, c)), bitand(b, c))
            var temp2 = S0 + maj
            hh = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
            i = i + 1
        h[0] = h[0] + a
        h[1] = h[1] + b
        h[2] = h[2] + c
        h[3] = h[3] + d
        h[4] = h[4] + e
        h[5] = h[5] + f
        h[6] = h[6] + g
        h[7] = h[7] + hh
        chunk = chunk + 128
    return h

var _H512 = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
             0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179]
var _H384 = [0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
             0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4]

var sha512 = Function(data):
    var h = _sha512core(data, _H512)
    var out = ""
    for v in h:
        out = out + _hex16(v)
    return out

var sha384 = Function(data):
    var h = _sha512core(data, _H384)
    var out = ""
    var i = 0
    while i < 6:                       # SHA-384 truncates to the first 6 of 8 words (48 bytes)
        out = out + _hex16(h[i])
        i = i + 1
    return out

# --- HMAC (RFC 2104) / PBKDF2 (RFC 2898) ---------------------------------------------------------
var _ALGOS = Set(["md5", "sha1", "sha256", "sha384", "sha512"])
var _hexToBytes = Function(hx):
    var out = []
    var i = 0
    while i < len(hx):
        out.append(_HEX.find(hx[i]) * 16 + _HEX.find(hx[i + 1]))
        i = i + 2
    return out
# raw digest (a byte list) for one of the supported algorithms, over a byte list
var _digest = Function(algo, byteList):
    var d = Bytes(byteList)
    if algo == "md5":
        return _hexToBytes(md5(d))
    if algo == "sha1":
        return _hexToBytes(sha1(d))
    if algo == "sha256":
        return _hexToBytes(sha256(d))
    if algo == "sha384":
        return _hexToBytes(sha384(d))
    if algo == "sha512":
        return _hexToBytes(sha512(d))
    throw "unknown algorithm '" + String(algo) + "' (expected md5/sha1/sha256/sha384/sha512)"
var _blocksize = Function(algo):
    return 128 if (algo == "sha384" or algo == "sha512") else 64
# HMAC over byte lists -> raw digest byte list
var _hmacRaw = Function(keyBytes, msgBytes, algo):
    var bs = _blocksize(algo)
    var key = List(keyBytes)
    if len(key) > bs:
        key = _digest(algo, key)
    while len(key) < bs:
        key.append(0)
    var inner = []
    var outer = []
    var i = 0
    while i < bs:
        inner.append(bitxor(key[i], 54))     # 0x36 ipad
        outer.append(bitxor(key[i], 92))     # 0x5c opad
        i = i + 1
    for b in msgBytes:
        inner.append(b)
    for b in _digest(algo, inner):
        outer.append(b)
    return _digest(algo, outer)
var hmac = Function(key, message, algorithm = "sha256"):
    if not (algorithm in _ALGOS):
        throw "unknown algorithm '" + String(algorithm) + "' (expected md5/sha1/sha256/sha384/sha512)"
    var raw = _hmacRaw(_bytesOf(key), _bytesOf(message), algorithm)
    var out = ""
    for b in raw:
        out = out + _HEX[b // 16] + _HEX[b % 16]
    return out
var pbkdf2 = Function(password, salt, iterations, dklen = 32, algorithm = "sha256"):
    if not (algorithm in _ALGOS):
        throw "unknown algorithm '" + String(algorithm) + "' (expected md5/sha1/sha256/sha384/sha512)"
    if iterations < 1:
        throw "pbkdf2: iterations must be >= 1"
    var pw = _bytesOf(password)
    var sl = _bytesOf(salt)
    var hlen = len(_digest(algorithm, []))
    var out = []
    var blockCount = (dklen + hlen - 1) // hlen
    var bi = 1
    while bi <= blockCount:
        var salti = List(sl)                          # salt || INT_32_BE(block index)
        salti.append((bi // 16777216) % 256)
        salti.append((bi // 65536) % 256)
        salti.append((bi // 256) % 256)
        salti.append(bi % 256)
        var u = _hmacRaw(pw, salti, algorithm)
        var t = List(u)
        var j = 1
        while j < iterations:
            u = _hmacRaw(pw, u, algorithm)
            var k = 0
            while k < len(t):
                t[k] = bitxor(t[k], u[k])
                k = k + 1
            j = j + 1
        for b in t:
            out.append(b)
        bi = bi + 1
    return Bytes(out[0:dklen])

# --- non-cryptographic checksums (crc32 / adler32) -----------------------------------------------
# CRC-32/ISO-HDLC (the zlib/gzip CRC): reflected polynomial 0xEDB88320, init/xorout 0xFFFFFFFF.
var _CRC32_TABLE = []
var _ct = 0
while _ct < 256:
    var _cc = _ct
    var _ck = 0
    while _ck < 8:
        if _cc % 2 == 1:
            _cc = _xor(3988292384, _cc // 2)
        else:
            _cc = _cc // 2
        _ck = _ck + 1
    _CRC32_TABLE.append(_cc)
    _ct = _ct + 1

var crc32 = Function(data):
    var crc = 4294967295
    for b in _bytesOf(data):
        crc = _xor(crc // 256, _CRC32_TABLE[_xor(crc % 256, b)])
    return _xor(crc, 4294967295)

var adler32 = Function(data):
    var a = 1
    var b = 0
    for byte in _bytesOf(data):
        a = (a + byte) % 65521
        b = (b + a) % 65521
    return b * 65536 + a

# CRC-64/XZ: reflected poly 0xC96C5795D7870F42, init/xorout all-ones, refin/refout. The 64-bit state
# is kept as two non-negative 32-bit halves [hi, lo] (the nibble _xor is 32-bit); the final value is
# reassembled with wrapping int64 multiply, which yields the correct signed two's-complement result.
var _CRC64_POLY_HI = 3379320725       # 0xC96C5795
var _CRC64_POLY_LO = 3615952706       # 0xD7870F42
var _CRC64_TABLE = []
var _q = 0
while _q < 256:
    var hi = 0
    var lo = _q
    var kk = 0
    while kk < 8:
        var bit0 = lo % 2
        # crc >> 1 (logical, 64-bit)
        var nlo = lo // 2 + (hi % 2) * 2147483648
        var nhi = hi // 2
        if bit0 == 1:
            hi = _xor(nhi, _CRC64_POLY_HI)
            lo = _xor(nlo, _CRC64_POLY_LO)
        else:
            hi = nhi
            lo = nlo
        kk = kk + 1
    _CRC64_TABLE.append([hi, lo])
    _q = _q + 1

var crc64 = Function(data):
    var hi = 4294967295
    var lo = 4294967295
    for b in _bytesOf(data):
        var ent = _CRC64_TABLE[_xor(lo % 256, b)]
        var shlo = lo // 256 + (hi % 256) * 16777216
        var shhi = hi // 256
        hi = _xor(shhi, ent[0])
        lo = _xor(shlo, ent[1])
    hi = 4294967295 - hi
    lo = 4294967295 - lo
    return hi * 4294967296 + lo

# hash(value) → Integer — the selfhost's parallel of the native `hash.hash(x)`. The native
# contract:
#   Integer   → value itself (identity), so `hash(0)==0`, `hash(-1)==-1`, INT64_MIN/MAX stay put.
#   Bool      → 1 / 0 (True hashes as 1, False as 0).
#   None      → 0.
#   Float     → deterministic; `0.0` and `-0.0` collapse (IEEE `==` says they are equal, so
#               their hashes must agree or Dict/Set lookup would diverge).
#   String    → FNV-1a over the UTF-8 bytes (content-based; equal-content Strings collide).
#   Bytes     → FNV-1a over the raw bytes.
#   Instance with `_hash_` → user method, return-type-checked (must be Integer).
#   List/Set/Dict/Function/Module and a class without `_hash_` → `unhashable type 'X'`.
#
# Composability: a user's own `_hash_` can call `hash.hash(self.subfield)` to fold nested
# attributes without knowing their type.
var _FNV32_OFFSET = 2166136261
var _FNV32_PRIME  = 16777619

# FNV-1a 32-bit over an iterable of byte-sized Integers. Fits the selfhost's non-negative 32-bit
# arithmetic model (`_xor` operates on unsigned 32-bit values, `_M32` = 2^32).
var _fnv1a = Function(bytes):
    var h = _FNV32_OFFSET
    for b in bytes:
        h = _xor(h, b)
        h = (h * _FNV32_PRIME) % _M32
    return h

var hash = Function(value):
    var tn = type(value)
    if tn == "Integer":
        return value
    if tn == "Bool":
        if value:
            return 1
        return 0
    if tn == "None":
        return 0
    if tn == "Float":
        # 0.0 and -0.0 are IEEE-equal, so their hashes must be too. String() of a Float is a
        # deterministic function of the value; normalising the sign of zero handles the -0.0 case.
        if value == 0.0:
            return 0
        return _fnv1a(_bytesOf(String(value)))
    if tn == "String":
        return _fnv1a(_bytesOf(value))
    if tn == "Bytes":
        return _fnv1a(List(value))
    if tn == "List" or tn == "Set" or tn == "Function" or tn == "Module":
        throw "unhashable type '" + tn + "'"
    # A user-class instance opts in via `_hash_`. Try attribute access; if it exists, call and
    # validate its return type.
    if hasattr(value, "_hash_"):
        var h = value._hash_()
        if type(h) != "Integer":
            throw "'" + tn + "'._hash_ must return an Integer, got '" + type(h) + "'"
        return h
    # A plain Dict (not an instance) is unhashable — but a Dict-shaped instance was handled above.
    if tn == "Dict":
        throw "unhashable type 'Dict'"
    # A class instance without `_hash_` is deliberately unhashable (matches the native rejection).
    throw "unhashable type '" + tn + "'"
