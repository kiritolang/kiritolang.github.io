# kpm — the Kirito package manager, written in Kirito itself.
#
# It installs packages (collections of `.ki` modules) straight from git hosting repositories. There is
# no central index: you name a repository. GitHub is the default, but any GitLab repo (gitlab.com or a
# self-hosted instance) works too. Run it as `kpm <command>` (the installer drops a launcher on your
# PATH) or directly with `ki kpm/kpm.ki <command>`.
#
# A <repo> may be written as:
#   owner/repo                       GitHub (the default — unchanged)
#   github.com/owner/repo            GitHub, explicit
#   gitlab.com/owner/repo            GitLab.com   (also gitlab:owner/repo)
#   https://gitlab.com/owner/repo    any full http(s) URL; the host type is auto-detected
#   gitlab+https://git.acme.com/o/r  force the host TYPE for a self-hosted GitLab (or github+… for GHE)
# A nested GitLab group path (group/subgroup/repo) is supported. A trailing .git is ignored.
#
#   kpm install <repo>[@<ref|constraint>] ...        download + install a package (and dependencies)
#   kpm remove  <name> ...                           uninstall a package
#   kpm list                                         list installed packages
#   kpm update  <name>... | --all                    re-resolve + reinstall (honours the constraint)
#   kpm outdated                                     show which installed packages have a newer version
#   kpm where                                        print the packages directory
#   kpm version                                      print the kpm + ki versions
#   kpm update-kpm  [--force]                        update kpm.ki itself from GitHub
#   kpm update-ki   [--force]                        update the `ki` interpreter binary itself
#   kpm help
#
# Versioning: an `@<ref>` is either a literal git ref (branch / tag / commit, e.g. `@main`) OR a
# semantic-version constraint resolved against the repo's tags (the `semver` module): `@1.2.3`
# (exact), `@^1.2.0`, `@~1.2`, `@1.x`, `@">=1.0.0 <2.0.0"` (quote ranges with spaces), `@*`. When a
# constraint is given, kpm picks the highest tag that satisfies it. The chosen constraint is recorded
# so `update`/`outdated` can re-resolve against newly-published tags.
#
# Dependency resolution UNIFIES constraints: the whole closure (the packages you name, their transitive
# dependencies, and what already-installed packages recorded needing) is resolved to one version per
# package BEFORE anything is written. Two requirements on the same package are intersected — the highest
# tag satisfying all of them wins. If none does, the install fails with a conflict naming the requesters
# and writes nothing. Each install records its own resolved dependency specs, so a later install is
# checked against the needs of what's already on disk (a cross-run reverse-dependency check).
#
# A package repository carries a `kirito.json` manifest at its root:
#
#   {
#     "name": "mypkg",
#     "version": "1.0.0",
#     "modules": ["mypkg.ki", "extra/util.ki"],
#     "dependencies": ["someone/dep@^1.0.0"]
#   }
#
# `modules` are repo-relative `.ki` paths. They install under `<packages>/<name>/` and become
# importable as `import("mypkg")` — `ki` puts the packages directory and every package sub-directory
# on the module import path automatically (see KIRITO_PATH / ~/.kirito/packages).
#
# Environment: $GITHUB_TOKEN (or $KPM_GITHUB_TOKEN) is sent as a GitHub bearer token, and $GITLAB_TOKEN
# (or $KPM_GITLAB_TOKEN) as a GitLab PRIVATE-TOKEN — lifting each host's anonymous rate limit and
# reaching private repos. $KPM_GITHUB_API / $KPM_GITHUB_RAW override the GitHub endpoints (for GitHub
# Enterprise, or testing). $KPM_SELF / $KPM_KI_PATH (set by the launcher) point update-kpm / update-ki
# at the files to replace. $KPM_TIMEOUT overrides the per-request network timeout in seconds (default
# 30) so a stalled host fails fast instead of hanging.

var io = import("io")
var net = import("net")
var json = import("json")
var sys = import("sys")
var semver = import("semver")
var path = import("path")
var hash = import("hash")

var KPM_VERSION = "1.5.0"

# Self-maintenance (update-kpm / update-ki) always targets the Kirito project on github.com; these are
# fixed and never redirected. The PACKAGE install path uses the host-aware adapters further down (so a
# package can come from GitHub or GitLab, github.com or a self-hosted instance).
var RAW = "https://raw.githubusercontent.com"
var API = "https://api.github.com"
var GH = "https://github.com"
# The Kirito project's own repository — the source for `update-kpm` and `update-ki`.
var KIRITO_REPO = "kiritolang/kiritolang.github.io"

# GitHub package endpoints, overridable via env so tests (and GitHub Enterprise) can redirect them.
# KPM_GITHUB_API / KPM_GITHUB_RAW take precedence over the public defaults.
var envOr = Function(name, dflt) -> String:
    var v = sys.getenv(name)
    return dflt if (v == None or v == "") else v
var ghApiBase = Function() -> String:
    return envOr("KPM_GITHUB_API", "https://api.github.com")
var ghRawBase = Function() -> String:
    return envOr("KPM_GITHUB_RAW", "https://raw.githubusercontent.com")

# ---------------------------------------------------------------- locations
var homeDir = Function() -> String:
    var h = sys.getenv("HOME")
    if h == None or h == "":
        h = sys.getenv("USERPROFILE")
    if h == None or h == "":
        throw "cannot locate your home directory (set HOME)"
    return h

var packagesDir = Function() -> String:
    return path.join(path.join(homeDir(), ".kirito"), "packages")

# ---------------------------------------------------------------- helpers
var fail = Function(msg):
    io.eprint("kpm: " + msg)
    sys.exit(1)

var hasFlag = Function(args, flag) -> Bool:
    for a in args:
        if a == flag:
            return True
    return False

# An env token by name list, or None. Sending it lifts a host's anonymous rate limit and reaches
# private repos.
var envToken = Function(names):
    for n in names:
        var t = sys.getenv(n)
        if t != None and t != "":
            return t
    return None

# A GitHub token ($GITHUB_TOKEN / $KPM_GITHUB_TOKEN) or None.
var ghToken = Function():
    return envToken(["GITHUB_TOKEN", "KPM_GITHUB_TOKEN"])

# Request headers for GitHub: the JSON API accept header plus a bearer token when one is configured.
var ghHeaders = Function():
    var h = {"Accept": "application/vnd.github+json"}
    var t = ghToken()
    if t != None:
        h["Authorization"] = "Bearer " + t
    return h

# Request headers for a parsed source (host-aware auth): GitHub uses a bearer token, GitLab the
# PRIVATE-TOKEN header ($GITLAB_TOKEN / $KPM_GITLAB_TOKEN).
var srcHeaders = Function(src):
    if src["kind"] == "gitlab":
        var h = {"Accept": "application/json"}
        var t = envToken(["GITLAB_TOKEN", "KPM_GITLAB_TOKEN"])
        if t != None:
            h["PRIVATE-TOKEN"] = t
        return h
    return ghHeaders()

# Per-request socket timeout in seconds. Without it a stalled or black-holed git host would hang kpm
# indefinitely (net's default is 0 = block forever). Bounds connect + each send/recv, so a slow but
# progressing download is fine while a dead connection fails fast. Overridable via $KPM_TIMEOUT.
var netTimeout = Function() -> Float:
    var v = sys.getenv("KPM_TIMEOUT")
    if v == None or v == "":
        return 30.0
    var n = None
    try:
        n = Float(v)
    catch as e:
        return 30.0
    return n if n > 0 else 30.0
var reqOpts = Function(headers):
    return {"headers": (ghHeaders() if headers == None else headers), "timeout": netTimeout()}

# GET a URL and return its body text; throws a clear message on a network error, timeout, or non-2xx
# status. `headers` defaults to GitHub's (self-maintenance); the install path passes host-aware headers.
var fetch = Function(url, headers = None) -> String:
    var r = None
    try:
        r = net.get(url, reqOpts(headers))
    catch as e:
        throw "network error fetching " + url + ": " + String(e)
    if not r.ok:
        throw "GET " + url + " -> HTTP " + String(r.statuscode)
    return r.text

# GET a URL and return its raw body as Bytes (for binary downloads, e.g. a release binary).
var fetchBytes = Function(url, headers = None):
    var r = None
    try:
        r = net.get(url, reqOpts(headers))
    catch as e:
        throw "network error fetching " + url + ": " + String(e)
    if not r.ok:
        throw "GET " + url + " -> HTTP " + String(r.statuscode)
    return r.content

# True iff `p` is a safe package-relative path: not empty, not absolute, no drive letter, and no `.`/
# `..`/empty component — so a manifest can never make kpm write outside the package directory (path
# traversal) or read an absolute file. Used to vet the package name and every module path.
var safeRelPath = Function(p) -> Bool:
    if p == None or type(p) != "String" or p == "":
        return False
    if p.startswith("/") or p.startswith("\\"):
        return False
    if len(p) >= 2 and p[1] == ":":            # Windows drive, e.g. C:\
        return False
    var norm = p.replace("\\", "/")
    for part in norm.split("/"):
        if part == "" or part == "." or part == "..":
            return False
    return True

# Validate a parsed manifest, throwing a clear error on anything malformed/unsafe. `where` names the
# source for the message. Returns [name, version, modules, dependencies].
var validateManifest = Function(manifest, where):
    if type(manifest) != "Dict":
        throw "kirito.json in " + where + " is not a JSON object"
    if "name" not in manifest or type(manifest["name"]) != "String" or manifest["name"] == "":
        throw "kirito.json in " + where + " is missing a non-empty string \"name\""
    var name = manifest["name"]
    if "/" in name or "\\" in name or not safeRelPath(name):
        throw "invalid package name '" + name + "' in " + where + " (no path separators or .. allowed)"
    if "modules" not in manifest or type(manifest["modules"]) != "List":
        throw "kirito.json in " + where + " is missing a \"modules\" list"
    if len(manifest["modules"]) == 0:
        throw "package '" + name + "' in " + where + " lists no modules"
    for m in manifest["modules"]:
        if not safeRelPath(m):
            throw "unsafe or invalid module path '" + String(m) + "' in package '" + name + "' (" + where + ")"
    var version = "0.0.0"
    if "version" in manifest:
        if type(manifest["version"]) != "String":
            throw "\"version\" must be a string in " + where
        version = manifest["version"]
    var deps = []
    if "dependencies" in manifest:
        if type(manifest["dependencies"]) != "List":
            throw "\"dependencies\" must be a list in " + where
        deps = manifest["dependencies"]
        for d in deps:
            if type(d) != "String" or d == "":
                throw "each dependency must be a non-empty string in " + where
    return [name, version, manifest["modules"], deps]

# Percent-encode a path for a GitLab API id (slashes -> %2F), encoding each component.
var glEnc = Function(s) -> String:
    var parts = []
    for c in s.split("/"):
        parts.append(net.quote(c))
    return "%2F".join(parts)

# Parse a package spec into a source Dict: {kind, host, scheme, path, ref, apibase, display}.
# Accepted forms (defaults to GitHub):
#   owner/repo                         github.com
#   github.com/owner/repo              github.com
#   gitlab.com/owner/repo              gitlab.com
#   host.tld/owner/repo                host.tld (must be a recognizable github/gitlab, else error)
#   https://host/owner/repo            any of the above, explicit scheme
#   github:owner/repo  gitlab:owner/repo               shorthands for the public hosts
#   github+<url>  gitlab+<url>                          force the host TYPE (self-hosted GHE / GitLab)
# A trailing @ref (after the last '/') is the version/ref; a trailing ".git" is stripped.
var parseSource = Function(spec):
    if spec == None or spec == "":
        throw "empty package spec"
    var ref = None
    var body = spec
    # The ref-separating '@' comes after the repo path. For a URL, start the search past the authority
    # so a "user@host" userinfo '@' is not mistaken for it; the ref itself may contain '/' (a branch
    # like "feature/x"), so take everything after the first '@' from there.
    var searchFrom = 0
    var sa = spec.find("://")
    if sa >= 0:
        var slashAfterAuth = spec.find("/", sa + 3)
        searchFrom = slashAfterAuth if slashAfterAuth >= 0 else (sa + 3)
    var atIdx = spec.find("@", searchFrom)
    if atIdx >= 0:
        ref = spec[atIdx + 1:]
        body = spec[0:atIdx]
        if ref == "":
            throw "empty @ref in '" + spec + "'"
    var forcedKind = None
    for k in ["github", "gitlab"]:
        if body.startswith(k + "+"):            # github+https://...  gitlab+https://...
            forcedKind = k
            body = body[len(k) + 1:]
    for k in ["github", "gitlab"]:
        if body.startswith(k + ":") and not body.startswith(k + "://"):   # github:owner/repo shorthand
            forcedKind = k
            body = body[len(k) + 1:]
    var scheme = "https"
    var host = None
    var path = body
    var schemeAt = body.find("://")
    if schemeAt >= 0:
        scheme = body[0:schemeAt]
        var afterScheme = body[schemeAt + 3:]
        var hs = afterScheme.find("/")
        if hs < 0:
            throw "invalid repository URL (no path after host): '" + spec + "'"
        host = afterScheme[0:hs]
        path = afterScheme[hs + 1:]
        var uat = host.find("@")                # drop any user[:pass]@ from the host
        if uat >= 0:
            host = host[uat + 1:]
    elif path.find("/") >= 0 and ("." in path[0:path.find("/")]):
        # a leading component containing a dot is a bare host: "gitlab.com/owner/repo"
        host = path[0:path.find("/")]
        path = path[path.find("/") + 1:]
    var qi = path.find("?")            # drop a ?query or #fragment glued to a pasted URL
    if qi >= 0:
        path = path[0:qi]
    var fi = path.find("#")
    if fi >= 0:
        path = path[0:fi]
    if path.endswith(".git"):
        path = path[0:len(path) - 4]
    while path.endswith("/"):
        path = path[0:len(path) - 1]
    while path.startswith("/"):
        path = path[1:]
    var kind = forcedKind
    if kind == None:
        var hl = host.lower() if host != None else None      # DNS host names are case-insensitive
        if hl == None or hl == "github.com" or "github" in hl:
            kind = "github"
        elif "gitlab" in hl:
            kind = "gitlab"
        else:
            throw "unrecognized git host '" + host + "' — prefix with 'gitlab+' or 'github+' to pick the host type (e.g. gitlab+" + scheme + "://" + host + "/" + path + ")"
    if host == None:
        host = "github.com" if kind == "github" else "gitlab.com"
    if path == "" or path.find("/") < 0:
        throw "expected <owner>/<repo>, got '" + spec + "'"
    # GitHub repositories are exactly <owner>/<repo> — it has no nested groups (GitLab does). A longer
    # path is a user mistake that would otherwise fail later with a confusing 404 on the manifest fetch.
    if kind == "github" and path.count("/") != 1:
        throw "GitHub repositories are <owner>/<repo> (no nested paths); got '" + path + "' in '" + spec + "'"
    var apibase = None
    if kind == "github":
        apibase = ghApiBase() if host == "github.com" else scheme + "://" + host + "/api/v3"
    else:
        apibase = scheme + "://" + host + "/api/v4"
    var display = path if (kind == "github" and host == "github.com") else host + "/" + path
    return {"kind": kind, "host": host, "scheme": scheme, "path": path, "ref": ref,
            "apibase": apibase, "display": display}

# The repo's default branch (one API call), used when no @ref is supplied.
var srcDefaultBranch = Function(src) -> String:
    if src["kind"] == "gitlab":
        var d = json.loads(fetch(src["apibase"] + "/projects/" + glEnc(src["path"]), srcHeaders(src)))
        return d["default_branch"]
    var data = json.loads(fetch(src["apibase"] + "/repos/" + src["path"], srcHeaders(src)))
    return data["default_branch"]

# The tags-API URL for one page (100 per page) on either host.
var srcTagsPageUrl = Function(src, page) -> String:
    var suffix = "/tags?per_page=100&page=" + String(page)
    if src["kind"] == "gitlab":
        return src["apibase"] + "/projects/" + glEnc(src["path"]) + "/repository" + suffix
    return src["apibase"] + "/repos/" + src["path"] + suffix

# Every tag name in the repo, as a List of Strings — the candidate versions a semver constraint
# resolves against. PAGINATED: both hosts cap a page at 100 and return tags in an unspecified order,
# so on a repo with >100 tags a single page would silently hide the very tag a constraint needs
# (resolving to a lower version, or failing outright). We walk every page and collect the complete
# set; `maxsatisfying` then scans all of it. The page cap bounds the walk against a broken pager.
var srcTags = Function(src):
    var names = []
    var page = 1
    var maxPages = 100          # 100 pages * 100 tags = 10k, an ample and safe upper bound
    while page <= maxPages:
        var data = json.loads(fetch(srcTagsPageUrl(src, page), srcHeaders(src)))
        if type(data) != "List" or len(data) == 0:
            break
        for t in data:
            names.append(t["name"])
        if len(data) < 100:     # a short page is necessarily the last one
            break
        page = page + 1
    return names

# The URL for one raw repo file at a concrete ref.
var srcRawUrl = Function(src, ref, relpath) -> String:
    if src["kind"] == "gitlab":
        return src["apibase"] + "/projects/" + glEnc(src["path"]) + "/repository/files/" + glEnc(relpath) + "/raw?ref=" + net.quote(ref)
    var rawbase = ghRawBase() if src["host"] == "github.com" else src["scheme"] + "://" + src["host"] + "/raw"
    return rawbase + "/" + src["path"] + "/" + ref + "/" + relpath

# The importable name a module path exposes to Kirito's `import(...)`. Each installed package sits at
# `<packages>/<pkg>/` and that directory is on the import path, so a repo-relative module `mypkg.ki`
# becomes `import("mypkg")` and `extra/util.ki` becomes `import("extra.util")` (slashes → dots, `.ki`
# stripped). Used to detect a collision — two packages that would install the same importable name.
var moduleImportName = Function(modPath) -> String:
    var name = modPath.replace("\\", "/")
    if name.endswith(".ki"):
        name = name[0:len(name) - 3]
    return name.replace("/", ".")

# Map every already-installed package's importable module names to the package that owns them, minus
# any package named in `excludeNames` (a Dict used as a set — so the packages being (re)installed this
# run don't collide with their own on-disk copies). Silently skips a package whose `.kpm.json` is
# missing or malformed — those are broken installs, not owners.
var installedModuleOwners = Function(excludeNames) -> Dict:
    var owners = {}
    for rec in listInstalled():
        if type(rec) != "Dict" or "name" not in rec:
            continue
        if rec["name"] in excludeNames:
            continue
        var mods = []
        if "modules" in rec and type(rec["modules"]) == "List":
            mods = rec["modules"]
        for m in mods:
            if type(m) == "String":
                owners[moduleImportName(m)] = rec["name"]
    return owners

# Write `text` to <dir>/<relpath>, creating any parent directories first.
var writeFile = Function(dir, relpath, text):
    var full = path.join(dir, relpath)
    var parent = path.dirname(full)
    if len(parent) > 0:
        discard path.mkdir(parent, exist_ok = True)
    var f = io.open(full, "w")
    f.write(text)
    f.close()

# ---------------------------------------------------------------- dependency resolution
# kpm resolves the FULL dependency closure to concrete versions BEFORE writing anything, UNIFYING every
# version constraint on each package. A package is keyed by its canonical source; the requirements on it
# — a top-level spec, transitive dependencies, AND what already-installed packages recorded needing —
# are intersected. If no version satisfies them all, resolution fails with a conflict naming the
# requesters and nothing is downloaded. This replaces the old first-wins-and-warn behaviour.

# The canonical, re-parseable source string for a parsed source: the key packages unify on, and what the
# install record stores so update/outdated can re-resolve.
var canonicalSource = Function(src) -> String:
    if src["kind"] == "github" and src["host"] == "github.com":
        return src["path"]
    if src["host"] == "gitlab.com" or src["host"] == "github.com":
        return src["host"] + "/" + src["path"]
    return src["kind"] + "+" + src["scheme"] + "://" + src["host"] + "/" + src["path"]

# Cached repo tags / default branch (one network call per source per resolve, reused across passes).
var tagsFor = Function(src, cache):
    var key = canonicalSource(src)
    if key not in cache:
        cache[key] = srcTags(src)
    return cache[key]
var defaultBranchFor = Function(src, cache):
    var key = canonicalSource(src)
    if key not in cache:
        cache[key] = srcDefaultBranch(src)
    return cache[key]

# Fetch + parse + validate a manifest at a concrete ref, cached by canonical-source@ref so the fixpoint
# never re-downloads the same one. Returns {name, version, modules, deps}.
var manifestAt = Function(src, ref, cache):
    var key = canonicalSource(src) + "@" + ref
    if key in cache:
        return cache[key]
    var text = None
    try:
        text = fetch(srcRawUrl(src, ref, "kirito.json"), srcHeaders(src))
    catch as e:
        throw "no kirito.json manifest in " + src["display"] + "@" + ref + " (" + String(e) + ")"
    var manifest = None
    try:
        manifest = json.loads(text)
    catch as e:
        throw "kirito.json in " + src["display"] + "@" + ref + " is not valid JSON: " + String(e)
    var parts = validateManifest(manifest, src["display"] + "@" + ref)
    var m = {"name": parts[0], "version": parts[1], "modules": parts[2], "deps": parts[3]}
    cache[key] = m
    return m

# Intersect every constraint on one source into a single concrete git ref. `cons` is a list of
# {c, by}: c is a semver range, a literal ref (branch/commit), or None (accept anything -> default
# branch). A literal ref can't be intersected — distinct pins, or a pin mixed with a range, is a
# conflict. Otherwise the highest tag satisfying ALL ranges wins; if none does, that is a conflict.
var pickRef = Function(src, cons, tagsCache, branchCache):
    var ranges = []
    var rangeBy = []
    var literals = []
    for req in cons:
        var c = req["c"]
        if c == None:
            continue
        if semver.validrange(c):
            ranges.append(c)
            rangeBy.append(req["by"])
        elif c not in literals:
            literals.append(c)
    if len(literals) > 0:
        if len(literals) > 1:
            throw "conflicting pinned refs for " + src["display"] + ": " + String(literals) + " cannot be unified"
        if len(ranges) > 0:
            throw "cannot combine pinned ref '" + literals[0] + "' with version range(s) " + String(ranges) + " for " + src["display"]
        return {"ref": literals[0], "isSemver": False}
    if len(ranges) > 0:
        var tags = tagsFor(src, tagsCache)
        var ok = []
        for t in tags:
            # Skip tags that aren't semver (repos routinely carry `latest`, `nightly`, date tags …) —
            # `satisfies` THROWS on a non-semver version, so this both matches `maxsatisfying`'s
            # tolerance and stops one stray tag from failing the whole resolution.
            if semver.valid(t) == None:
                continue
            var sat = True
            for r in ranges:
                if not semver.satisfies(t, r):
                    sat = False
            if sat:
                ok.append(t)
        if len(ok) == 0:
            throw ("no version of " + src["display"] + " satisfies all constraints " + String(ranges) +
                   " (required by " + String(rangeBy) + "); available tags: " + String(tags))
        var best = ok[0]
        for t in ok:
            if semver.gt(semver.clean(t), semver.clean(best)):
                best = t
        return {"ref": best, "isSemver": True}
    return {"ref": defaultBranchFor(src, branchCache), "isSemver": False}

# What each ALREADY-INSTALLED package requires of its dependencies: canonical source -> [{c, by}]. Read
# from the recorded "dependencies" of every install, so a NEW install is checked against the needs of
# packages already on disk (the cross-run reverse-dependency check). Malformed records are skipped.
var reverseDepsOfInstalled = Function():
    var rev = {}
    for rec in listInstalled():
        if type(rec) != "Dict" or "name" not in rec:
            continue
        var deps = rec["dependencies"] if ("dependencies" in rec and type(rec["dependencies"]) == "List") else []
        for d in deps:
            if type(d) != "String":
                continue
            var dsrc = None
            try:
                dsrc = parseSource(d)
            catch as e:
                continue
            var canon = canonicalSource(dsrc)
            if canon not in rev:
                rev[canon] = []
            # `byCanon` = the source of the package that recorded this need. When that package is itself
            # being (re)resolved this run, its FRESH manifest supersedes this stale recorded dep, so the
            # resolver drops this entry (see PHASE A) — otherwise updating a package that bumped its own
            # dependency would falsely conflict with its old record.
            var byCanon = rec["source"] if ("source" in rec and type(rec["source"]) == "String") else None
            rev[canon].append({"c": dsrc["ref"], "by": String(rec["name"]) + " (installed)", "byCanon": byCanon})
    return rev

# Resolve `topSpecs` (+ their transitive deps, unified with installed packages' recorded needs) into a
# concrete plan: {"nodes": canonical -> node, "order": [canonical...] deps-first, "top": [...]}. A node
# is {src, canonical, ref, isSemver, version, name, modules, deps, depCanons, constraint}.
#
# Two-phase fixpoint: each pass (A) builds the COMPLETE constraint list for every known source from the
# seeds + reverse-deps + the previous pass's picked manifests, then (B) picks a ref per source and reads
# its manifest, recording any newly-discovered dependency for the next pass. Because picking always uses
# constraints fully collected in the prior pass (never a half-built one), the chosen versions are
# correct regardless of traversal order; versions only fall as constraints accumulate, so it converges
# in O(dependency-depth) passes. A hard cap turns any pathological case into a clear error, never a hang.
var resolvePlan = Function(topSpecs):
    var rev = reverseDepsOfInstalled()
    var tagsCache = {}
    var branchCache = {}
    var manifestCache = {}
    var known = {}          # canonical -> src
    var seedCons = {}       # canonical -> [{c, by}]  (top-level requirements)
    for spec in topSpecs:
        var s = parseSource(spec)
        var canon = canonicalSource(s)
        known[canon] = s
        if canon not in seedCons:
            seedCons[canon] = []
        seedCons[canon].append({"c": s["ref"], "by": "requested"})
    var derivedPrev = {}    # canonical -> [{c, by}]  (from the previous pass's picked manifests)
    var prevPicks = {}
    var nodes = {}
    var iter = 0
    var maxIter = 100
    var stable = False
    while not stable and iter < maxIter:
        iter = iter + 1
        # PHASE A: the full constraint list for every currently-known source.
        var cons = {}
        for canon in known:
            var lst = []
            if canon in seedCons:
                lst = lst + seedCons[canon]
            if canon in rev:
                # A recorded reverse-dep counts only if its owner is NOT itself being resolved now —
                # a package in `known` contributes its CURRENT deps via derivedPrev, not its old record.
                for e in rev[canon]:
                    if e["byCanon"] == None or e["byCanon"] not in known:
                        lst.append(e)
            if canon in derivedPrev:
                lst = lst + derivedPrev[canon]
            cons[canon] = lst
        # PHASE B: pick + read manifest for every known source; collect this pass's derived constraints
        # and any newly-discovered dependency (added to `known` for the next pass).
        var newPicks = {}
        var newNodes = {}
        var derivedNew = {}
        var discoveredSrc = {}
        for canon in List(known):
            var src = known[canon]
            var pick = pickRef(src, cons[canon], tagsCache, branchCache)
            newPicks[canon] = pick
            var m = manifestAt(src, pick["ref"], manifestCache)
            var depCanons = []
            for dep in m["deps"]:
                var dsrc = parseSource(dep)
                var dcanon = canonicalSource(dsrc)
                depCanons.append(dcanon)
                if dcanon not in derivedNew:
                    derivedNew[dcanon] = []
                derivedNew[dcanon].append({"c": dsrc["ref"], "by": String(m["name"])})
                if dcanon not in known:
                    discoveredSrc[dcanon] = dsrc
            newNodes[canon] = {"src": src, "canonical": canon, "ref": pick["ref"],
                               "isSemver": pick["isSemver"], "version": m["version"],
                               "name": m["name"], "modules": m["modules"], "deps": m["deps"],
                               "depCanons": depCanons,
                               "constraint": (cons[canon][0]["c"] if len(cons[canon]) > 0 else None)}
        var discovered = False
        for dcanon in discoveredSrc:
            if dcanon not in known:
                known[dcanon] = discoveredSrc[dcanon]
                discovered = True
        # Fixpoint: nothing newly discovered AND every pick unchanged from the last pass.
        var same = not discovered and len(newPicks) == len(prevPicks)
        if same:
            for k in newPicks:
                if k not in prevPicks or prevPicks[k]["ref"] != newPicks[k]["ref"]:
                    same = False
        stable = same
        derivedPrev = derivedNew
        prevPicks = newPicks
        nodes = newNodes
    if not stable:
        throw "could not resolve dependencies within " + String(maxIter) + " passes (unstable constraint graph)"
    # Deps-first install order (post-order DFS from the top specs; the `placed` guard breaks cycles).
    var topCanons = []
    for spec in topSpecs:
        topCanons.append(canonicalSource(parseSource(spec)))
    var order = []
    var placed = {}
    var visit = None
    visit = Function(canon):
        if canon in placed:
            return None
        placed[canon] = True
        if canon in nodes:
            for dc in nodes[canon]["depCanons"]:
                visit(dc)
            order.append(canon)
    for c in topCanons:
        visit(c)
    for c in nodes:
        if c not in placed:
            placed[c] = True
            order.append(c)
    return {"nodes": nodes, "order": order, "top": topCanons}

# Validate a resolved plan before any file is written: two plan packages must not share a name; a plan
# package must not shadow a DIFFERENT already-installed package's name or any installed importable module
# name; and each manifest's own module set must be internally unique and non-empty.
var validateResolved = Function(nodes):
    var nameToCanon = {}
    for canon in nodes:
        var nm = nodes[canon]["name"]
        if nm in nameToCanon and nameToCanon[nm] != canon:
            throw ("two packages in this install resolve to the same name '" + nm + "': '" +
                   nameToCanon[nm] + "' and '" + canon + "' — rename one of the packages")
        nameToCanon[nm] = canon
    var planNames = {}
    for canon in nodes:
        planNames[nodes[canon]["name"]] = True
    for canon in nodes:
        var nm = nodes[canon]["name"]
        var existing = readRecord(nm)
        if existing != None and "source" in existing and existing["source"] != canon:
            throw ("package name '" + nm + "' is already installed from '" + existing["source"] +
                   "'; refusing to overwrite it with a different source '" + canon +
                   "' — run `kpm remove " + nm + "` first, or rename one of the packages")
    var owners = installedModuleOwners(planNames)    # installed modules, minus packages we will overwrite
    for canon in nodes:
        var n = nodes[canon]
        var mine = {}
        for m in n["modules"]:
            var imp = moduleImportName(m)
            if imp == "":
                throw ("package '" + n["name"] + "' has a module path '" + m +
                       "' with an empty importable name (a bare '.ki' or a directory ending in '/.ki')")
            if imp in mine:
                throw ("package '" + n["name"] + "' declares two modules for the same importable name '" +
                       imp + "': '" + mine[imp] + "' and '" + m + "'")
            mine[imp] = m
        for imp in mine:
            if imp in owners:
                throw ("package '" + n["name"] + "' would install module '" + imp +
                       "' but it is already provided by package '" + owners[imp] +
                       "' — refusing to install; remove the conflicting package first")
            owners[imp] = n["name"]

# Download + write one resolved package's modules and its install record. The record carries the
# resolved dependency specs so a later install can reverse-check against them.
var installNode = Function(n):
    var src = n["src"]
    var dest = path.join(packagesDir(), n["name"])
    var installed = []
    for mod in n["modules"]:
        var text = None
        try:
            text = fetch(srcRawUrl(src, n["ref"], mod), srcHeaders(src))
        catch as e:
            throw "package '" + n["name"] + "': module '" + mod + "' not found at " + src["display"] + "@" + n["ref"] + " (" + String(e) + ")"
        writeFile(dest, mod, text)
        installed.append(mod)
        io.print("  + " + mod)
    var record = {"name": n["name"], "version": n["version"], "source": n["canonical"],
                  "constraint": n["constraint"], "ref": n["ref"], "modules": installed,
                  "dependencies": n["deps"]}
    writeFile(dest, ".kpm.json", json.dumps(record, indent = 2))

# Install every node of a resolved plan (deps first). A package already on disk at the exact resolved
# IMMUTABLE tag is left untouched; a branch/default ref is always refreshed (its content can move).
# Returns the number of packages actually (re)installed.
var installResolved = Function(plan):
    var nodes = plan["nodes"]
    var count = 0
    for canon in plan["order"]:
        var n = nodes[canon]
        var existing = readRecord(n["name"])
        var upToDate = (existing != None and n["isSemver"] and "source" in existing and
                        existing["source"] == n["canonical"] and "ref" in existing and
                        existing["ref"] == n["ref"] and "version" in existing and
                        existing["version"] == n["version"])
        if upToDate:
            io.print(n["name"] + " " + n["version"] + " already up to date (" + n["src"]["display"] + "@" + n["ref"] + ")")
            continue
        io.print("installing " + n["name"] + " " + n["version"] + " (" + n["src"]["display"] + "@" + n["ref"] + ")")
        installNode(n)
        count = count + 1
    return count

# Read the install record of one package, or None if it isn't installed. A corrupt or hand-edited
# `.kpm.json` (or one that isn't a JSON object) is a broken install, NOT a fatal error: return None so
# `list`, `outdated`, `update`, and collision detection skip it instead of the whole tool crashing on
# one bad file. The file is always closed, even when parsing throws.
var readRecord = Function(name):
    var rec = path.join(path.join(packagesDir(), name), ".kpm.json")
    if not path.exists(rec):
        return None
    var f = io.open(rec, "r")
    var text = f.read()
    f.close()
    try:
        var data = json.loads(text)
        return data if type(data) == "Dict" else None
    catch as e:
        return None

# Read the install records of every installed package.
var listInstalled = Function():
    var root = packagesDir()
    var out = []
    if not path.exists(root):
        return out
    for entry in path.listdir(root):
        var data = readRecord(entry)
        if data != None:
            out.append(data)
    return out

# The latest published GitHub release of a repo, as the parsed API object (has "tag_name", "assets").
var latestRelease = Function(repo):
    return json.loads(fetch(API + "/repos/" + repo + "/releases/latest"))

# The release-asset filename for the running platform (ki-<os>-<arch>[.exe]). Only the platforms we
# publish binaries for are mapped; anything else throws (build from source instead).
var kiAssetName = Function() -> String:
    var os = sys.platform
    var arch = sys.arch
    if os == "linux" and arch == "x64":
        return "ki-linux-x64"
    if os == "windows" and arch == "x64":
        return "ki-windows-x64.exe"
    throw "no prebuilt ki binary for " + os + "/" + arch + " — build from source (install.sh --from-source)"

# Extract `KPM_VERSION = "x.y.z"` from kpm.ki source text, or None. The assignment near the top of the
# file precedes the marker's own occurrence in this function, so `find` lands on the real value.
var extractKpmVersion = Function(text):
    var marker = "KPM_VERSION = \""
    var at = text.find(marker)
    if at < 0:
        return None
    var start = at + len(marker)
    var endq = text.find("\"", start)
    if endq < 0:
        return None
    return text[start:endq]

# Find the SHA-256 hex digest for `asset` in the text of a `SHA256SUMS` file (standard `sha256sum`
# output: "<hex>  <name>", with an optional '*' before a binary-mode name), lowercased, or None if the
# asset is not listed. Pure so it can be unit-tested without the network.
var shaFor = Function(sumsText, asset):
    for line in sumsText.split("\n"):
        var ln = line.strip()
        if ln == "":
            continue
        var sp = ln.find(" ")
        if sp < 0:
            continue
        var digest = ln[0:sp]
        var fname = ln[sp:].strip()
        if fname.startswith("*"):        # `sha256sum -b` marks a binary-mode file with a leading '*'
            fname = fname[1:]
        if fname == asset:
            return digest.lower()
    return None

# Atomically replace `target` with the file at `tmp`. POSIX rename swaps the inode under a running
# process; Windows can't overwrite a running .exe, so the old file is moved aside first.
var replaceFile = Function(tmp, target):
    discard path.remove(target + ".old", missing_ok = True)
    if sys.platform == "windows":
        if path.exists(target):
            path.rename(target, target + ".old")
        path.rename(tmp, target)
    else:
        path.rename(tmp, target)

# ---------------------------------------------------------------- commands
var cmdInstall = Function(specs):
    if len(specs) == 0:
        fail("install needs at least one <owner/repo>")
    var plan = None
    try:
        # Resolve + validate the WHOLE closure before touching disk, so a conflict or a bad manifest
        # aborts cleanly with nothing half-installed.
        plan = resolvePlan(specs)
        validateResolved(plan["nodes"])
    catch as e:
        fail(String(e))
    var n = 0
    try:
        n = installResolved(plan)
    catch as e:
        fail(String(e))
    io.print("done — " + String(len(plan["nodes"])) + " package(s) resolved, " + String(n) +
             " installed/updated, in " + packagesDir())

var cmdRemove = Function(names):
    if len(names) == 0:
        fail("remove needs a package name")
    for name in names:
        # Vet the name exactly like the install side: a bare package name, never a path. Otherwise
        # `kpm remove ../../foo` (or an absolute path) would rmtree OUTSIDE ~/.kirito/packages.
        if "/" in name or "\\" in name or not safeRelPath(name):
            fail("invalid package name: " + name)
        var dir = path.join(packagesDir(), name)
        if not path.exists(dir):
            io.eprint("kpm: not installed: " + name)
        else:
            # Warn (don't block — removal is an explicit act) if another installed package depends on
            # this one: removing it will break that dependent. Uses the recorded dependency graph.
            var rec = readRecord(name)
            if rec != None and "source" in rec:
                var dependents = []
                for other in listInstalled():
                    if type(other) != "Dict" or "name" not in other or other["name"] == name:
                        continue
                    var odeps = other["dependencies"] if ("dependencies" in other and type(other["dependencies"]) == "List") else []
                    for d in odeps:
                        if type(d) != "String":
                            continue
                        try:
                            if canonicalSource(parseSource(d)) == rec["source"]:
                                dependents.append(other["name"])
                        catch as e:
                            continue
                if len(dependents) > 0:
                    io.eprint("kpm: warning: '" + name + "' is required by " + String(dependents) +
                              " — they may stop working")
            discard path.rmtree(dir, missing_ok = True)   # recursive rm -rf
            io.print("removed " + name)

var cmdList = Function():
    var pkgs = listInstalled()
    if len(pkgs) == 0:
        io.print("no packages installed")
        return None
    for p in pkgs:
        var at = p["ref"]
        if "constraint" in p and p["constraint"] != None:
            at = String(p["constraint"]) + " -> " + p["ref"]
        io.print(p["name"] + " " + p["version"] + "  (" + p["source"] + "@" + at + ")")

# Reinstall the given packages (or all of them), re-resolving each recorded constraint so a semver
# range picks up newly-published tags. The whole set is resolved together (and unified against every
# installed package's recorded needs), so an update that would break a dependent fails cleanly rather
# than silently installing an incompatible version.
var cmdUpdate = Function(args):
    var targets = []
    if len(args) == 1 and args[0] == "--all":
        targets = listInstalled()
    else:
        for name in args:
            var rec = readRecord(name)
            if rec == None:
                fail("not installed: " + name)
            targets.append(rec)
    if len(targets) == 0:
        fail("update needs a package name or --all")
    var specs = []
    for p in targets:
        var spec = p["source"]
        if "constraint" in p and p["constraint"] != None:
            spec = spec + "@" + String(p["constraint"])
        specs.append(spec)
    try:
        var plan = resolvePlan(specs)
        validateResolved(plan["nodes"])
        discard installResolved(plan)
    catch as e:
        fail(String(e))
    for p in targets:
        io.print("updated " + p["name"])

# Resolve the newest version available to a package under its recorded constraint (or the manifest
# version on its ref), or None if it can't be determined.
var latestFor = Function(p):
    var src = parseSource(p["source"])
    if "constraint" in p and p["constraint"] != None and semver.validrange(p["constraint"]):
        var best = semver.maxsatisfying(srcTags(src), p["constraint"])
        if best != None:
            return semver.clean(best)
    var m = json.loads(fetch(srcRawUrl(src, p["ref"], "kirito.json"), srcHeaders(src)))
    if "version" in m:
        return m["version"]
    return None

var cmdOutdated = Function():
    var pkgs = listInstalled()
    if len(pkgs) == 0:
        io.print("no packages installed")
        return None
    var stale = 0
    for p in pkgs:
        var have = p["version"]
        var latest = None
        try:
            latest = latestFor(p)
        catch as e:
            latest = None
        if latest == None:
            io.print("  " + p["name"] + " " + have + " -> ? (could not determine latest)")
        elif semver.valid(have) != None and semver.valid(latest) != None and semver.gt(latest, have):
            io.print("  " + p["name"] + " " + have + " -> " + latest + "  (" + p["source"] + ")")
            stale = stale + 1
    if stale == 0:
        io.print("all packages are up to date")
    else:
        io.print(String(stale) + " package(s) can be updated — run `kpm update --all`")

var cmdVersion = Function():
    io.print("kpm " + KPM_VERSION)
    io.print("ki  " + sys.version + "  (" + sys.platform + "/" + sys.arch + ")")
    if path.executable != None and path.executable != "":
        io.print("    " + path.executable)

# Update kpm.ki itself from GitHub. Replaces the file named by $KPM_SELF (set by the launcher),
# falling back to ~/.kirito/kpm.ki.
var cmdSelfUpdate = Function(args):
    var force = hasFlag(args, "--force") or hasFlag(args, "-f")
    var target = sys.getenv("KPM_SELF")
    if target == None or target == "":
        target = path.join(path.join(homeDir(), ".kirito"), "kpm.ki")
    var url = RAW + "/" + KIRITO_REPO + "/main/kpm/kpm.ki"
    var text = None
    try:
        text = fetch(url)
    catch as e:
        fail("could not fetch kpm.ki: " + String(e))
    var remote = extractKpmVersion(text)
    io.print("current kpm: " + KPM_VERSION + "   latest: " + (remote if remote != None else "?"))
    if not force and remote != None and semver.valid(remote) != None and not semver.gt(remote, KPM_VERSION):
        io.print("kpm is up to date (" + KPM_VERSION + ")")
        return None
    var parent = path.dirname(target)
    if len(parent) > 0:
        discard path.mkdir(parent, exist_ok = True)
    var f = io.open(target, "w")
    f.write(text)
    f.close()
    io.print("updated kpm -> " + (remote if remote != None else "latest") + "  (" + target + ")")

# Update the `ki` interpreter binary itself: download the latest release asset for this platform and
# atomically swap it in over the running executable (located via path.executable, or $KPM_KI_PATH).
var cmdUpgradeKi = Function(args):
    var force = hasFlag(args, "--force") or hasFlag(args, "-f")
    var current = sys.version
    var rel = None
    try:
        rel = latestRelease(KIRITO_REPO)
    catch as e:
        fail("could not query the latest release: " + String(e))
    var tag = rel["tag_name"]
    var latest = semver.clean(tag)
    io.print("current ki: " + current + "   latest: " + tag)
    if not force and semver.valid(latest) != None and not semver.gt(latest, current):
        io.print("ki is up to date (" + current + ")")
        return None

    var target = sys.getenv("KPM_KI_PATH")
    if target == None or target == "":
        target = path.executable
    if target == None or target == "":
        fail("cannot locate the ki executable to replace (set KPM_KI_PATH)")

    var asset = None
    try:
        asset = kiAssetName()
    catch as e:
        fail(String(e))
    var url = GH + "/" + KIRITO_REPO + "/releases/download/" + tag + "/" + asset
    io.print("downloading " + asset + " ...")
    var blob = None
    try:
        blob = fetchBytes(url)
    catch as e:
        fail("download failed: " + String(e))

    # Verify the download against the release's published SHA256SUMS before executing it — a corrupted
    # or tampered binary must never be swapped in. `--force` explicitly opts out (e.g. an older release
    # that predates published checksums); this is a deliberate, logged reduction in safety.
    if not force:
        var sums = None
        try:
            sums = fetch(GH + "/" + KIRITO_REPO + "/releases/download/" + tag + "/SHA256SUMS")
        catch as e:
            fail("release " + tag + " publishes no SHA256SUMS to verify the download; re-run with " +
                 "--force to skip verification (not recommended): " + String(e))
        var want = shaFor(sums, asset)
        if want == None:
            fail("SHA256SUMS for " + tag + " does not list '" + asset +
                 "' — refusing to install an unverified binary (use --force to override)")
        var got = hash.sha256(blob).lower()
        if got != want:
            fail("checksum mismatch for " + asset + ": expected " + want + " but got " + got +
                 " — refusing to install a corrupted or tampered download")
        io.print("verified sha256 " + got)

    var tmp = target + ".new"
    var f = io.open(tmp, "wb")
    f.write(blob)
    f.close()
    discard path.chmod(tmp, 0o755)
    replaceFile(tmp, target)
    io.print("upgraded ki -> " + tag + "  (" + target + ")")

var usage = Function():
    io.print("kpm — the Kirito package manager (GitHub by default, or any GitLab/GitHub repo; no index)")
    io.print("usage:")
    io.print("  kpm install <repo>[@<ref|constraint>] ...        install package(s) + dependencies")
    io.print("       <repo> is owner/repo (GitHub), gitlab.com/owner/repo, a full https URL, or")
    io.print("       gitlab:owner/repo / github+<url> / gitlab+<url> for self-hosted instances")
    io.print("  kpm remove  <name> ...                           uninstall")
    io.print("  kpm list                                         list installed packages")
    io.print("  kpm update  <name>... | --all                    re-resolve + reinstall")
    io.print("  kpm outdated                                     show packages with a newer version")
    io.print("  kpm where                                        print the packages directory")
    io.print("  kpm version                                      print the kpm + ki versions")
    io.print("  kpm update-kpm  [--force]                        update kpm itself")
    io.print("  kpm update-ki   [--force]                        update the ki interpreter")
    io.print("  kpm help")
    io.print("")
    io.print("an @constraint is a git ref (@main) or a semver range (@^1.2.0, @1.x, @\">=1 <2\")")

# ---------------------------------------------------------------- dispatch
if argmain:
    if len(arglist) == 0:
        usage()
    else:
        var cmd = arglist[0]
        var rest = arglist[1:]
        switch cmd:
            case "install", "i", "add":
                cmdInstall(rest)
            case "remove", "rm", "uninstall":
                cmdRemove(rest)
            case "list", "ls":
                cmdList()
            case "update", "upgrade":
                cmdUpdate(rest)
            case "outdated":
                cmdOutdated()
            case "where":
                io.print(packagesDir())
            case "version", "--version", "-v":
                cmdVersion()
            case "update-kpm", "self-update", "selfupdate":
                cmdSelfUpdate(rest)
            case "update-ki", "upgrade-ki", "upgrade-kirito", "self-upgrade":
                cmdUpgradeKi(rest)
            case "help", "-h", "--help":
                usage()
            default:
                io.eprint("kpm: unknown command '" + cmd + "'")
                usage()
                sys.exit(2)
