# Adversarial/edge coverage for the String & Bytes types — converted from
# tests/unit/test_strbytes_deep.cpp: type-check throws on numeric secondary arguments (window
# start/end, split maxsplit, replace count, justify width), Bytes float-index / zero-step-slice /
# cross-type-ordering throws, UTF-8 validation branches (overlong, surrogate), and the encode/decode
# default + latin-1 paths. All error cases are runtime (bad argument types / malformed UTF-8), so
# they are folded inline via try/catch. Runs identically with `ki` and `ki --no-inline`.
var io = import("io")

# ---- window helper: a Float start/end throws on every search method ----
try:
    discard "abcabc".find("a", 1.0)
catch as e:
    io.print(e)
try:
    discard "abcabc".rfind("a", 1.0)
catch as e:
    io.print(e)
try:
    discard "abcabc".index("a", 1.0)
catch as e:
    io.print(e)
try:
    discard "abcabc".rindex("a", 1.0)
catch as e:
    io.print(e)
try:
    discard "abcabc".count("a", 1.0)
catch as e:
    io.print(e)
try:
    discard "abcabc".startswith("a", 1.0)
catch as e:
    io.print(e)
try:
    discard "abcabc".endswith("c", 1.0)
catch as e:
    io.print(e)
# but an Integer window works (sanity, and covers the [start, end] window itself)
io.print("abcabc".find("a", 1))
io.print("abcabc".count("a", 0, 3))
io.print("abcabc".find("a", 1, 2))

# ---- split maxsplit / replace count as Float throw ----
try:
    discard "a,b,c".split(",", 1.5)
catch as e:
    io.print(e)
try:
    discard "aaa".replace("a", "b", 1.5)
catch as e:
    io.print(e)
# integer maxsplit / count still work
io.print("a,b,c".split(",", 1))
io.print("aaa".replace("a", "b", 2))

# ---- justify/zfill Float width throws (neg + missing already covered elsewhere) ----
try:
    discard "x".ljust(5.0)
catch as e:
    io.print(e)
try:
    discard "x".rjust(5.0)
catch as e:
    io.print(e)
try:
    discard "x".center(5.0)
catch as e:
    io.print(e)
try:
    discard "x".zfill(5.0)
catch as e:
    io.print(e)

# ---- Bytes float index + zero-step slice + cross-type ordering throw ----
try:
    discard Bytes([1, 2, 3])[1.0]
catch as e:
    io.print(e)
try:
    discard Bytes([1, 2, 3])[::0]
catch as e:
    io.print(e)
try:
    discard Bytes([1]) < "x"
catch as e:
    io.print(e)
# a valid Bytes index / slice still works
io.print(Bytes([10, 20, 30])[1])
io.print(Bytes([10, 20, 30])[-1])

# ---- UTF-8 validation: overlong encoding + surrogate range must throw on decode ----
try:
    discard Bytes([0xc0, 0x80]).decode()        # overlong NUL
catch as e:
    io.print(e)
try:
    discard Bytes([0xed, 0xa0, 0x80]).decode()  # UTF-16 surrogate D800
catch as e:
    io.print(e)
try:
    discard Bytes([0xc3]).decode()              # truncated lead
catch as e:
    io.print(e)
try:
    discard Bytes([0x80]).decode()              # stray continuation
catch as e:
    io.print(e)

# ---- encode/decode: explicit None means the default (utf-8), same as omission ----
io.print(len("é".encode(None)) == len("é".encode()))
io.print("é".encode(None).decode(None) == "é")
io.print(len("é".encode()))                 # é is 2 UTF-8 bytes

# ---- latin-1 (iso-8859-1) is a lossless byte<->code-point map ----
io.print("é".encode("iso-8859-1")[0])       # U+00E9 -> 0xE9
io.print(len("café".encode("iso-8859-1")))
io.print(Bytes([233]).decode("latin-1"))
# ascii encoding of a non-ascii code point throws
try:
    discard "é".encode("ascii")
catch as e:
    io.print(e)

# ---- round-trip: hex/fromhex, and Bytes ordering among Bytes ----
io.print(Bytes([255, 16, 0]).hex())
io.print(Bytes([1, 2]) < Bytes([1, 3]))
io.print(Bytes([1, 2]) < Bytes([1, 2, 0]))  # shorter prefix is smaller
