# The Bytes type (binary strings: encode/decode, indexing, slicing, ops), the gzip codec, binary
# file I/O, and serialization. Bytes is the byte-exact counterpart to the (Unicode) String type, so
# binary data — downloads, compressed streams, file contents — round-trips losslessly. Converted
# from tests/unit/test_bytes.cpp (the pure run-a-script-check-a-value cases; the gzipfmt C++-interop
# block that calls the codec directly, not through Kirito source, stays in the trimmed .cpp). All
# error cases are runtime (bad constructor/encode/decode/fromhex arguments), so they are folded
# inline via try/catch. Runs identically with `ki` and `ki --no-inline`.
var io = import("io")

# --- construction + repr -------------------------------------------------------------------
io.print(Bytes([72, 105]))
io.print(type(Bytes([1, 2, 3])))
io.print(Bytes(3))                          # n zero bytes
io.print(Bytes("AB"))                       # String -> utf-8 bytes
io.print(Bytes(Bytes([5, 6])))              # copy
io.print(Bytes())                           # empty
io.print(Bytes([10, 9, 13, 92, 39]))        # escapes in repr
try:
    discard Bytes([256])                    # out of range
catch as e:
    io.print(e)
try:
    discard Bytes([0 - 1])
catch as e:
    io.print(e)
try:
    discard Bytes([1.5])                    # not an Integer
catch as e:
    io.print(e)

# --- length / indexing / slicing -----------------------------------------------------------
io.print(len(Bytes([1, 2, 3, 4])))
io.print(Bytes([10, 20, 30])[1])            # byte value as Integer
io.print(Bytes([10, 20, 30])[-1])           # negative index
io.print(type(Bytes([10, 20, 30])[0]))
try:
    discard Bytes([1, 2])[5]                # out of range
catch as e:
    io.print(e)
io.print(Bytes([1, 2, 3, 4, 5])[1:4])       # slice -> Bytes
io.print(type(Bytes([1, 2, 3])[0:2]))
io.print(Bytes([1, 2, 3, 4, 5])[::2])       # step
io.print(Bytes([1, 2, 3])[::-1])            # reverse

# --- iteration / membership / ops ----------------------------------------------------------
io.print(List(Bytes([65, 66, 67])))
io.print(66 in Bytes([65, 66, 67]))
io.print(99 in Bytes([65, 66, 67]))
io.print(Bytes([66, 67]) in Bytes([65, 66, 67]))   # subsequence
io.print(Bytes([1, 2]) + Bytes([3, 4]))
io.print(Bytes([7]) * 3)
io.print(Bytes([1, 2, 3]) == Bytes([1, 2, 3]))
io.print(Bytes([1, 2, 3]) == Bytes([1, 2, 4]))
io.print(Bytes([1, 2]) < Bytes([1, 3]))     # lexicographic
io.print(Bytes([1, 2, 3]) == "abc")         # never equal to a String
# hashable -> usable as a Dict/Set key
var dicttest = Function():
    var d = {Bytes([1]): "a", Bytes([2]): "b"}
    return d[Bytes([2])]
io.print(dicttest())
io.print(len(Set([Bytes([1]), Bytes([1]), Bytes([2])])))

# --- encode / decode -----------------------------------------------------------------------
io.print("hello".encode())                  # default utf-8
io.print(type("x".encode()))
io.print(len("héllo".encode("utf-8")))      # é is 2 bytes in utf-8
io.print(Bytes([104, 105]).decode())
io.print(Bytes([104, 105]).decode("utf-8"))
# latin-1 is a lossless byte<->code-point map (every byte 0..255 round-trips)
io.print("é".encode("latin-1"))             # U+00E9 -> one byte 0xE9
io.print(Bytes([0xc3, 0xa9]).decode("latin-1").encode("latin-1") == Bytes([0xc3, 0xa9]))
try:
    discard "€".encode("latin-1")           # U+20AC > 255
catch as e:
    io.print(e)
try:
    discard "é".encode("ascii")             # > 127
catch as e:
    io.print(e)
try:
    discard "x".encode("utf-99")            # unknown encoding
catch as e:
    io.print(e)

# --- hex -----------------------------------------------------------------------------------
io.print(Bytes([72, 105, 33]).hex())
io.print(fromhex("486921").decode())
io.print(fromhex("48 69 21"))               # whitespace ignored
try:
    discard fromhex("abc")                  # odd length
catch as e:
    io.print(e)
try:
    discard fromhex("xy")                   # non-hex
catch as e:
    io.print(e)

# --- full byte-transparency: all 256 byte values round-trip through latin-1 -----------------
var latin1roundtrip = Function():
    var ok = True
    var i = 0
    while i < 256:
        var b = Bytes([i])
        if b.decode("latin-1").encode("latin-1") != b or b[0] != i:
            ok = False
        i = i + 1
    return ok
io.print(latin1roundtrip())

# --- gzip module: round-trip (String and Bytes), same-type preservation, verb aliases -------
var gziproundtrip = Function():
    var g = import("gzip")
    var msg = "the quick brown fox " * 20
    return g.decompress(g.compress(msg)) == msg
io.print(gziproundtrip())
io.print(type(import("gzip").compress(Bytes([1, 2, 3]))))
io.print(type(import("gzip").compress("text")))
var gunziptest = Function():
    var g = import("gzip")
    var b = Bytes([0, 1, 127, 128, 255, 254, 0, 10])
    return g.gunzip(g.gzip(b)) == b         # gzip/gunzip verb aliases
io.print(gunziptest())
# zlib / deflate also preserve the input type and round-trip
io.print(import("zlib").decompress(import("zlib").compress("hi there")) == "hi there")
io.print(import("zlib").inflate(import("zlib").deflate(Bytes([9, 8, 7]))) == Bytes([9, 8, 7]))
# crc32 of "hello" is a known constant (the checksums live in the hash module)
io.print(import("hash").crc32("hello"))
io.print(import("hash").crc32(Bytes([104, 101, 108, 108, 111])))   # same via Bytes
# corrupt gzip input throws cleanly
try:
    discard import("gzip").decompress("not a gzip stream at all really")
catch as e:
    io.print(e)

# --- binary file I/O: write Bytes ("wb"), read Bytes ("rb") exactly back --------------------
var binaryfiletest = Function():
    var fio = import("io")
    var z = import("gzip")
    var path = import("path").join(import("path").gettempdir(), "kirito_bytes_test.bin")
    var data = z.compress(Bytes("payload with embedded \x00 null and \xff high bytes here", "latin-1"))
    var f = fio.open(path, "wb")
    f.write(data)
    f.close()
    var g = fio.open(path, "rb")
    var back = g.read()
    g.close()
    import("path").remove(path)
    return type(back) == "Bytes" and back == data
io.print(binaryfiletest())

# --- serialization: a Bytes round-trips through both graph formats --------------------------
var serdetest = Function():
    var s = import("serialize")
    var d = import("dump")
    var b = Bytes([0, 1, 2, 200, 255, 10, 13])
    return s.loads(s.dumps(b)) == b and d.loads(d.dumps(b)) == b
io.print(serdetest())
# nested inside a container
var nestedtest = Function():
    var d = import("dump")
    var payload = {"name": "file.gz", "data": Bytes([31, 139, 8, 0]), "list": [Bytes([1]), Bytes([2])]}
    var back = d.loads(d.dumps(payload))
    return back["data"] == Bytes([31, 139, 8, 0]) and back["list"][1] == Bytes([2])
io.print(nestedtest())

# --- inspect describes the type ------------------------------------------------------------
io.print(inspect(Bytes([1])).find("decode") >= 0)
