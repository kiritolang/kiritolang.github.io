# The built-in `tabular` module (Series/DataFrame): a Kirito integration test that the frozen module
# loads and its core surface works end-to-end (converted from tests/unit/test_tabular.cpp — fully
# deterministic, no filesystem). The trailing adversarial cases are runtime errors, caught inline.
# Runs identically with `ki` and `ki --no-inline`.
var io = import("io")
var pd = import("tabular")

# --- Series ---
io.print(pd.Series([1, 2, 3, 4]).sum())
io.print(pd.Series([1, 2, 3, 4]).mean())
io.print(pd.Series([3, 1, 2]).sortvalues().tolist())
io.print((pd.Series([1, 2, 3]) * 10).tolist())
io.print((pd.Series([1, 2, 3, 4]) > 2).tolist())
io.print((pd.Series([1, 2, 1]) == 1).tolist())
io.print((pd.Series(["a", "b", "a"]) != "a").tolist())
var dfk = pd.DataFrame({"k": ["x", "y", "x"], "v": [1, 2, 3]}, columns=["k", "v"])
io.print(dfk[dfk["k"] == "x"]["v"].tolist())
io.print(pd.Series([1, None, 3]).sum())
io.print(pd.Series([1, None, 3]).dropna().tolist())

# --- DataFrame construction + selection ---
var mkdf = Function():
    return pd.DataFrame([["Ada", 36], ["Alan", 41], ["Grace", 85]], columns=["name", "age"])
io.print(mkdf().shape())
io.print(mkdf().columns)
io.print(mkdf()["age"].tolist())
io.print(mkdf().iloc[1]["name"])
io.print(mkdf()[mkdf()["age"] > 40]["name"].tolist())
io.print(mkdf().sortvalues("age", ascending=False)["name"].tolist())

# --- CSV round-trip + type inference ---
io.print(type(pd.readcsv("a,b\n1,2.5")["a"][0]))
io.print(type(pd.readcsv("a,b\n1,2.5")["b"][0]))
io.print(pd.readcsv("x\n1\n2\n3")["x"].sum())

# --- group-by ---
var mkgb = Function():
    var df = pd.DataFrame({"k": ["a", "b", "a", "b"], "v": [1, 2, 3, 4]}, columns=["k", "v"])
    return df.groupby("k")
io.print(mkgb().sum()["v"].tolist())
io.print(mkgb().mean()["v"].tolist())
io.print(mkgb().size().tolist())

# --- joins + concat ---
var mkl = Function():
    return pd.DataFrame([[1, "x"], [2, "y"]], columns=["id", "a"])
var mkr = Function():
    return pd.DataFrame([[1, "p"], [3, "q"]], columns=["id", "b"])
io.print(pd.merge(mkl(), mkr(), on="id").shape())
io.print(pd.merge(mkl(), mkr(), on="id", how="left")["b"].tolist())
io.print(pd.concat([pd.DataFrame([[1]], columns=["x"]), pd.DataFrame([[2]], columns=["x"])])["x"].tolist())

# --- missing-data on a frame ---
io.print(len(pd.readcsv("a,b\n1,\n2,3").dropna()))
io.print(pd.readcsv("a,b\n1,\n2,3").fillna(0)["b"].tolist())

# --- edge cases: empty / all-missing / out-of-bounds degrade gracefully ---
io.print(len(pd.Series([])))
io.print(pd.Series([]).sum())
io.print(pd.Series([]).mean())
io.print(pd.Series([]).count())
io.print(pd.Series([None, None]).count())
io.print(pd.Series([None, None]).mean())
io.print(pd.Series([None, 1, None]).fillna(0).tolist())
io.print(pd.Series([7]).std())
io.print(pd.readcsv("").shape())
io.print(pd.readcsv("a,b,c").shape())
io.print(pd.DataFrame({"a": [1, 2, 3]}, columns=["a"]).head(0).shape())
io.print(pd.DataFrame({"a": [1, 2]}, columns=["a"]).head(99).shape())
io.print(pd.merge(pd.DataFrame([[1, "a"], [2, "b"]], columns=["id", "x"]), pd.DataFrame([[1, "p"], [1, "q"], [2, "r"]], columns=["id", "y"]), on="id").shape())
io.print(len(pd.merge(pd.DataFrame([[1]], columns=["id"]), pd.DataFrame([[9]], columns=["id"]), on="id")))
io.print(pd.DataFrame([[1, "a"], [1, "b"], [1, "c"]], columns=["k", "t"]).sortvalues("k")["t"].tolist())

# --- adversarial: malformed input and out-of-domain operations throw (never crash) ---
var bad = Function(fn):
    try:
        discard fn()
        return "no-throw"
    catch as e:
        return "threw"
io.print(bad(Function(): return pd.DataFrame({"a": [1, 2], "b": [1]}, columns=["a", "b"])))
io.print(bad(Function(): return pd.Series([1, 2, 3], index=["a"])))
io.print(bad(Function(): return pd.DataFrame({"a": [1]}, columns=["a"])["nope"]))
io.print(bad(Function(): return pd.Series([1, 2, 3]) + pd.Series([1, 2])))
io.print(bad(Function(): return pd.DataFrame({"a": [1]}, columns=["a"]).iloc[5]))
io.print(bad(Function(): return pd.DataFrame({"a": [1]}, columns=["a"]).groupby("nope")))
io.print(bad(Function(): return pd.DataFrame({"k": ["x"], "v": [1]}, columns=["k", "v"]).groupby("k").agg({"v": "bogus"})))
