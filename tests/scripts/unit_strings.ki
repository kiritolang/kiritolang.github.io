# length/indexing/out-of-range across every non-f string literal form (double, single,
# triple-double, triple-single, and their raw variants) — a string behaves the same however it is
# written (converted from tests/unit/test_strings.cpp). Runs identically with `ki` and
# `ki --no-inline`.
var io = import("io")

io.print(len("hello"))
io.print("abc"[0])
io.print("abc"[-1])
try:
    discard "abc"[9]
catch as e:
    io.print(e)

io.print(len('hello'))
io.print('abc'[0])
io.print('abc'[-1])
try:
    discard 'abc'[9]
catch as e:
    io.print(e)

io.print(len("""hello"""))
io.print("""abc"""[0])
io.print("""abc"""[-1])
try:
    discard """abc"""[9]
catch as e:
    io.print(e)

io.print(len('''hello'''))
io.print('''abc'''[0])
io.print('''abc'''[-1])
try:
    discard '''abc'''[9]
catch as e:
    io.print(e)

io.print(len(r"hello"))
io.print(r"abc"[0])
io.print(r"abc"[-1])
try:
    discard r"abc"[9]
catch as e:
    io.print(e)

io.print(len(r'hello'))
io.print(r'abc'[0])
io.print(r'abc'[-1])
try:
    discard r'abc'[9]
catch as e:
    io.print(e)

io.print(len(r"""hello"""))
io.print(r"""abc"""[0])
io.print(r"""abc"""[-1])
try:
    discard r"""abc"""[9]
catch as e:
    io.print(e)

io.print(len(r'''hello'''))
io.print(r'''abc'''[0])
io.print(r'''abc'''[-1])
try:
    discard r'''abc'''[9]
catch as e:
    io.print(e)

# iteration over characters (double, single, and triple forms)
var s = ""
for c in "abc":
    s = s + c
io.print(s)

var n1 = 0
for c in 'hello':
    n1 = n1 + 1
io.print(n1)

var n2 = 0
for c in """hello""":
    n2 = n2 + 1
io.print(n2)

# strict lexical addressing across statements: a closure defined earlier captures a later variable
# by handle and observes a later mutation (mirrors the REPL's persistent module scope).
var x = 1
x = x + 1
io.print(x)

var g = 10
var f = Function(): return g
io.print(f())
g = 20
io.print(f())
