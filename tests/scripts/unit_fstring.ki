# f-string interpolation: basic substitution, {{ }} escapes, expressions, format specs, the same
# f-string across all four flavours, raw-f, and single-quote keys inside a double-quoted f-string
# (converted from tests/unit/test_fstring.cpp — the pure evalStr()-vs-hand-written-value cases). The
# 3 placeholder-source-location checks (errLoc, using KiritoError::span, a C++-API-only concept with
# no Kirito-level accessor) are not expressible in Kirito and stay in tests/unit/test_fstring.cpp.
# Runs identically with `ki` and `ki --no-inline`.
var io = import("io")

# Block A: basic interpolation, {{ }} escapes, expressions, list/dict values
var n1 = 7
io.print(f"n is {n1}")
var a1 = 3
var b1 = 4
io.print(f"{a1} + {b1} = {a1 + b1}")
io.print(f"{{escaped}} {1 + 1}")
var name1 = "World"
io.print(f"Hello, {name1}!")
io.print(f"{[1, 2, 3]}")
io.print(f"no placeholders")
var x1 = 10
io.print(f"{x1 // 3} remainder {x1 % 3}")
var p1 = [5, 9]
io.print(f"sum is {p1[0] + p1[1]}")
# format specs
var x2 = 42
io.print(f"{x2:05d}")
var pi1 = 3.14159
io.print(f"{pi1:.2f}")
io.print(f"{x2:#x}")
io.print(f"{x2:>5}|")
io.print(f"{1000000:,}")
io.print(f"{[1, 2, 3][1]:03d}")
var s1 = "abcde"
io.print(f"{s1[1:3]}")
io.print(f"{ {7: 8}[7] }")
var x3 = 5
io.print(f"{ x3 }")
io.print(f"a{  x3  }b")
# the SAME f-string in all four flavours, and raw-f leaving backslashes alone
var nF1 = 7
io.print(f"n is {nF1}")
var aF1 = 3
var bF1 = 4
io.print(f"{aF1} + {bF1} = {aF1 + bF1}")
io.print(f"{{esc}} {1 + 1}")
var xF1 = 42
io.print(f"{xF1:05d}")
io.print(f"no placeholders")
var pF1 = [5, 9]
io.print(f"sum is {pF1[0] + pF1[1]}")
var nF2 = 7
io.print(f'n is {nF2}')
var aF2 = 3
var bF2 = 4
io.print(f'{aF2} + {bF2} = {aF2 + bF2}')
io.print(f'{{esc}} {1 + 1}')
var xF2 = 42
io.print(f'{xF2:05d}')
io.print(f'no placeholders')
var pF2 = [5, 9]
io.print(f'sum is {pF2[0] + pF2[1]}')
var nF3 = 7
io.print(f"""n is {nF3}""")
var aF3 = 3
var bF3 = 4
io.print(f"""{aF3} + {bF3} = {aF3 + bF3}""")
io.print(f"""{{esc}} {1 + 1}""")
var xF3 = 42
io.print(f"""{xF3:05d}""")
io.print(f"""no placeholders""")
var pF3 = [5, 9]
io.print(f"""sum is {pF3[0] + pF3[1]}""")
var nF4 = 7
io.print(f'''n is {nF4}''')
var aF4 = 3
var bF4 = 4
io.print(f'''{aF4} + {bF4} = {aF4 + bF4}''')
io.print(f'''{{esc}} {1 + 1}''')
var xF4 = 42
io.print(f'''{xF4:05d}''')
io.print(f'''no placeholders''')
var pF4 = [5, 9]
io.print(f'''sum is {pF4[0] + pF4[1]}''')
# raw f-strings: backslashes literal, expression still evaluated
var n2 = 7
io.print(rf"a\t{n2}")
io.print(fr'{n2}\n')
# single-quote keys inside a double-quoted f-string
var d1 = {"k": 8}
io.print(f"{d1['k']}")
