# String/List operations: unicode indexing, slicing, membership, repetition, methods, formatting,
# literal-form equivalence, Levenshtein distance (converted from tests/unit/test_string_ops.cpp).
# Runs identically with `ki` and `ki --no-inline`.
var io = import("io")

# --- Unicode (indexing/length by code point, not byte) ---
io.print(len("héllo"))
io.print("héllo"[1])
io.print(len("ab€"))
io.print("ab€"[2])
var un = 0
for c in "ab€":
    un = un + 1
io.print(un)

# --- slicing (String) ---
io.print("hello"[1:4])
io.print("hello"[:3])
io.print("hello"[2:])
io.print("hello"[-2:])
io.print("hello"[::-1])
io.print("hello"[::2])

# --- slicing (List) ---
io.print([1, 2, 3, 4, 5][1:4])
io.print([1, 2, 3][::-1])

# --- in / not in ---
io.print("ell" in "hello")
io.print("z" in "hello")
io.print(2 in [1, 2, 3])
io.print(5 not in [1, 2, 3])
io.print("a" in {"a": 1})
io.print(2 in {1, 2, 3})

# --- repetition ---
io.print("ab" * 3)

# --- methods ---
io.print("Hello".upper())
io.print("Hello".lower())
io.print("  hi  ".strip())
io.print(len("a,b,c".split(",")))
io.print("a,b,c".split(",")[1])
io.print(",".join(["a", "b", "c"]))
io.print("hello".replace("l", "L"))
io.print("hello".startswith("he"))
io.print("hello".endswith("lo"))
io.print("hello".find("ll"))
io.print("banana".count("a"))

# --- formatting ---
io.print("{} + {} = {}".format(1, 2, 3))
io.print("{0} {0}".format("hi"))
io.print("{}%".format(50))

# forms("Hello") -- every non-f literal spelling gives identical results
io.print("Hello".upper())
io.print("Hello".lower())
io.print(len("Hello"))
io.print("Hello"[0])
io.print("Hello"[-1])
io.print("Hello"[1:4])
io.print("Hello"[::-1])
io.print("Hello" * 2)
io.print("Hello".startswith('He'))
io.print('ell' in "Hello")
io.print("Hello" == 'Hello')
io.print('Hello'.upper())
io.print('Hello'.lower())
io.print(len('Hello'))
io.print('Hello'[0])
io.print('Hello'[-1])
io.print('Hello'[1:4])
io.print('Hello'[::-1])
io.print('Hello' * 2)
io.print('Hello'.startswith('He'))
io.print('ell' in 'Hello')
io.print('Hello' == 'Hello')
io.print("""Hello""".upper())
io.print("""Hello""".lower())
io.print(len("""Hello"""))
io.print("""Hello"""[0])
io.print("""Hello"""[-1])
io.print("""Hello"""[1:4])
io.print("""Hello"""[::-1])
io.print("""Hello""" * 2)
io.print("""Hello""".startswith('He'))
io.print('ell' in """Hello""")
io.print("""Hello""" == 'Hello')
io.print('''Hello'''.upper())
io.print('''Hello'''.lower())
io.print(len('''Hello'''))
io.print('''Hello'''[0])
io.print('''Hello'''[-1])
io.print('''Hello'''[1:4])
io.print('''Hello'''[::-1])
io.print('''Hello''' * 2)
io.print('''Hello'''.startswith('He'))
io.print('ell' in '''Hello''')
io.print('''Hello''' == 'Hello')
io.print(r"Hello".upper())
io.print(r"Hello".lower())
io.print(len(r"Hello"))
io.print(r"Hello"[0])
io.print(r"Hello"[-1])
io.print(r"Hello"[1:4])
io.print(r"Hello"[::-1])
io.print(r"Hello" * 2)
io.print(r"Hello".startswith('He'))
io.print('ell' in r"Hello")
io.print(r"Hello" == 'Hello')
io.print(r'Hello'.upper())
io.print(r'Hello'.lower())
io.print(len(r'Hello'))
io.print(r'Hello'[0])
io.print(r'Hello'[-1])
io.print(r'Hello'[1:4])
io.print(r'Hello'[::-1])
io.print(r'Hello' * 2)
io.print(r'Hello'.startswith('He'))
io.print('ell' in r'Hello')
io.print(r'Hello' == 'Hello')
io.print(r"""Hello""".upper())
io.print(r"""Hello""".lower())
io.print(len(r"""Hello"""))
io.print(r"""Hello"""[0])
io.print(r"""Hello"""[-1])
io.print(r"""Hello"""[1:4])
io.print(r"""Hello"""[::-1])
io.print(r"""Hello""" * 2)
io.print(r"""Hello""".startswith('He'))
io.print('ell' in r"""Hello""")
io.print(r"""Hello""" == 'Hello')
io.print(r'''Hello'''.upper())
io.print(r'''Hello'''.lower())
io.print(len(r'''Hello'''))
io.print(r'''Hello'''[0])
io.print(r'''Hello'''[-1])
io.print(r'''Hello'''[1:4])
io.print(r'''Hello'''[::-1])
io.print(r'''Hello''' * 2)
io.print(r'''Hello'''.startswith('He'))
io.print('ell' in r'''Hello''')
io.print(r'''Hello''' == 'Hello')
# forms("a,b,c")
io.print(len("a,b,c".split(',')))
io.print("a,b,c".split(',')[1])
io.print("a,b,c".replace(',', '-'))
io.print("a,b,c".count(','))
io.print(len('a,b,c'.split(',')))
io.print('a,b,c'.split(',')[1])
io.print('a,b,c'.replace(',', '-'))
io.print('a,b,c'.count(','))
io.print(len("""a,b,c""".split(',')))
io.print("""a,b,c""".split(',')[1])
io.print("""a,b,c""".replace(',', '-'))
io.print("""a,b,c""".count(','))
io.print(len('''a,b,c'''.split(',')))
io.print('''a,b,c'''.split(',')[1])
io.print('''a,b,c'''.replace(',', '-'))
io.print('''a,b,c'''.count(','))
io.print(len(r"a,b,c".split(',')))
io.print(r"a,b,c".split(',')[1])
io.print(r"a,b,c".replace(',', '-'))
io.print(r"a,b,c".count(','))
io.print(len(r'a,b,c'.split(',')))
io.print(r'a,b,c'.split(',')[1])
io.print(r'a,b,c'.replace(',', '-'))
io.print(r'a,b,c'.count(','))
io.print(len(r"""a,b,c""".split(',')))
io.print(r"""a,b,c""".split(',')[1])
io.print(r"""a,b,c""".replace(',', '-'))
io.print(r"""a,b,c""".count(','))
io.print(len(r'''a,b,c'''.split(',')))
io.print(r'''a,b,c'''.split(',')[1])
io.print(r'''a,b,c'''.replace(',', '-'))
io.print(r'''a,b,c'''.count(','))
# forms("  hi  ")
io.print("  hi  ".strip())
io.print('  hi  '.strip())
io.print("""  hi  """.strip())
io.print('''  hi  '''.strip())
io.print(r"  hi  ".strip())
io.print(r'  hi  '.strip())
io.print(r"""  hi  """.strip())
io.print(r'''  hi  '''.strip())
# forms("{} + {} = {}")
io.print("{} + {} = {}".format(1, 2, 3))
io.print('{} + {} = {}'.format(1, 2, 3))
io.print("""{} + {} = {}""".format(1, 2, 3))
io.print('''{} + {} = {}'''.format(1, 2, 3))
io.print(r"{} + {} = {}".format(1, 2, 3))
io.print(r'{} + {} = {}'.format(1, 2, 3))
io.print(r"""{} + {} = {}""".format(1, 2, 3))
io.print(r'''{} + {} = {}'''.format(1, 2, 3))

# f-string reproduces the same result as .format across quote flavours
var x = 5
io.print(f'{x} + {x}')
io.print(f"""{x} + {x}""")

# --- Levenshtein (Unicode edit distance), scalar + List forms ---
io.print("kitten".levenshtein("sitting"))
io.print("abc".levenshtein("abc"))
io.print("".levenshtein("abc"))
io.print("café".levenshtein("cafe"))
io.print("a😀".levenshtein("a"))
io.print("kitten".levenshtein(["sitting", "kitten", "kit"]))
io.print("cat".levenshtein(other = "cut"))
try:
    discard "abc".levenshtein(5)
catch as e:
    io.print(e)
try:
    discard "abc".levenshtein(["ok", 7])
catch as e:
    io.print(e)

# the `string` module's fuzzy helpers, built on it
io.print(import("string").closest("swft", ["swift", "ruby", "rust"]))
io.print(import("string").similarity("abc", "abc"))
