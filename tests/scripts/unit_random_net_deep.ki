# random: distribution defaults, under-arity/bad-input error surfaces, engine selection, and
# serialize/dump round-tripping an RNG's state (its stream reproduces after (de)serialization). net:
# pure URL helpers (quote/unquote, urlencode/parseqs) — no live server needed. Converted from
# tests/unit/test_random_net_deep.cpp; server-dependent net paths (redirects, resolveUrl, Socket host
# resolution) stay in the net loopback harness (tools/tests/unit/test_net.cpp), out of scope here.
# All cases seed explicitly (random.Random(N)); assertions check type/inequality/determinism/
# round-trip invariants, never a specific drawn value, so results are stable across runs. Runs
# identically with `ki` and `ki --no-inline`.
var io = import("io")
var random = import("random")

# ================= random (all deterministic under a fixed seed) =================

# ---- distribution defaults: gauss()/expovariate() with fewer than the usual args ----
io.print(isinstance(random.Random(42).gauss(), Float))
io.print(isinstance(random.Random(42).gauss(5), Float))
io.print(isinstance(random.Random(42).expovariate(), Float))
# two identically-seeded generators agree (default gauss consumes the same draws)
io.print(random.Random(42).gauss() == random.Random(42).gauss())

# ---- under-arity guards throw ----
try:
    discard random.Random(42).uniform(1)
catch as e:
    io.print(e)
try:
    discard random.Random(42).sample([1, 2, 3])
catch as e:
    io.print(e)
try:
    discard random.Random(42).randint(1)
catch as e:
    io.print(e)
try:
    discard random.Random(42).seed()               # seed expects a value
catch as e:
    io.print(e)

# ---- non-iterable / empty population guards throw ----
try:
    discard random.Random(42).sample(5, 2)
catch as e:
    io.print(e)
try:
    discard random.Random(42).choice(5)
catch as e:
    io.print(e)
try:
    discard random.Random(42).choice([])
catch as e:
    io.print(e)

# ---- resource / arity caps throw ----
try:
    discard random.Random(42).choices([1, 2], k = 300000000)   # k too large
catch as e:
    io.print(e)
try:
    discard random.Random(42).randrange(1, 2, 3, 4)             # 1..3 args
catch as e:
    io.print(e)

# ---- both engines: .generator name, and serialize round-trip reproduces the stream ----
io.print(random.Random(42, "mersenne_twister").generator)
io.print(random.Random(42).generator != "mersenne_twister")   # default xoshiro

var serialize = import("serialize")
var r = random.Random(42)
discard r.randint(1, 1000000)
var r2 = serialize.loads(serialize.dumps(r))
io.print(r.randint(1, 1000000) == r2.randint(1, 1000000))

var dump = import("dump")
var rd = random.Random(99, "mersenne_twister")
discard rd.random()
var rd2 = dump.loads(dump.dumps(rd))
io.print(rd.random() == rd2.random())

# ================= net URL helpers (pure — no server) =================

# ---- quote / unquote round-trip and exact space encoding ----
var net = import("net")
io.print(net.quote("a b"))
io.print(net.unquote("a%20b"))
io.print(net.unquote(net.quote("héllo world/?&=x")) == "héllo world/?&=x")

# ---- urlencode of a Dict contains each field; parseqs recovers the key ----
io.print("a=1" in net.urlencode({"a": 1}))
io.print("a" in net.parseqs("a=1&b=2"))

# NOTE: HTTP redirect method-downgrade (301/302/303/307/308), resolveUrl absolute/bare-relative,
# Socket.bind/connect host-resolution, and the TLS handshake path all require a live server and
# belong in the net loopback/HTTPS harness (tools/tests/unit/test_net.cpp), not this pure suite.
