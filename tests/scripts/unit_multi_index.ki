# Multi-index subscripting: Matrix supports m[i, j] read/write (and m[i] for a row); single-index
# containers (List, Dict, String) reject extra indices — arity is enforced. (Converted from
# tests/unit/test_multi_index.cpp; all error cases are runtime and are caught inline.)
# Runs identically with `ki` and `ki --no-inline`.
var io = import("io")
var matrix = import("matrix")
var m = matrix.Matrix([[1, 2, 3], [4, 5, 6]])

io.print(m[0, 0])
io.print(m[1, 2])
io.print(m[1])
m[0, 1] = 99
io.print(m[0, 1])
try:
    discard m[5, 5]
catch as e:
    io.print(e)
try:
    m[0] = 1                        # assignment needs two indices
catch as e:
    io.print(e)

# Single-index containers reject extra indices (arity is enforced).
io.print([10, 20, 30][1])
try:
    discard [1, 2, 3][0, 1]
catch as e:
    io.print(e)
var d = {"a": 1}
try:
    discard d["a", "b"]
catch as e:
    io.print(e)
try:
    discard "abc"[0, 1]
catch as e:
    io.print(e)

# Dict/List/String single indexing still works.
io.print({"a": 1, "b": 2}["b"])
io.print("hello"[1])
