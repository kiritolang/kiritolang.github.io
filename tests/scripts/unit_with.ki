# `with` context managers: enter/body/exit ordering, exit-on-throw with propagation, and the value
# bound by `as` (converted from tests/unit/test_with.cpp). Runs identically with `ki` and
# `ki --no-inline`.
var io = import("io")

class Resource:
    var _init_ = Function(self, log):
        self.log = log
    var _enter_ = Function(self):
        self.log.append("enter")
        return self
    var _exit_ = Function(self):
        self.log.append("exit")

# enter/body/exit run in order; `as` binds enter()'s return value
var basic = Function():
    var log = []
    with Resource(log) as r:
        log.append("body")
    return log
io.print(basic())

# exit runs even when the body throws, and the exception still propagates to an outer handler
var onthrow = Function():
    var log = []
    try:
        with Resource(log) as r:
            log.append("body")
            throw "boom"
    catch as e:
        log.append("caught " + e)
    return log
io.print(onthrow())

# the bound value is the manager (enter returned self)
var boundvalue = Function():
    var log = []
    with Resource(log) as r:
        r.log.append("via-r")
    return log
io.print(boundvalue())
