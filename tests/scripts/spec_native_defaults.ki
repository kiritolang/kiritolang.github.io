# Hardening: calling a signatured native with trailing args OMITTED must fill the declared defaults
# (the .ki/applyCall path; the C++ Value::call path is covered by test_native_default_binding.cpp).
var int = import("int")
var io = import("io")
assert int.isprimeaks(97), "isprimeaks default maxdegree fills"
assert int.isprimeaks(97) == int.isprimeaks(97, 1048576), "omitted maxdegree == explicit default"
assert int.isprobableprime(97), "isprobableprime default rounds fills"
assert int.isprobableprime(97) == int.isprobableprime(97, 40), "omitted rounds == explicit default"
assert round(2.5) == 3, "round default ndigits"
assert round(2.3456, 2) == 2.35, "round explicit ndigits"
assert int.big(97).isprimeaks(), "BigInt.isprimeaks default maxdegree"
assert int.big(97).isprobableprime(), "BigInt.isprobableprime default rounds"
# omitting a REQUIRED arg still throws cleanly (never OOB)
var threw = False
try:
    discard int.modpow(2, 3)
catch:
    threw = True
assert threw, "missing required arg throws"
io.print("OK native defaults")
