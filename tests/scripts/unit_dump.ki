# The `dump` module: binary serialization of Kirito values, including Kirito-defined functions/
# classes/instances, shared references, and cycles (converted from tests/unit/test_dump.cpp). The
# cross-VM "an instance carries its class" check genuinely needs two independent VM instances (one
# that never defines the class), which a single interpreter process cannot do -- it is reproduced here
# by having THIS process spawn a second, fresh `ki` process (via sys.createprocess, targeting
# path.executable -- i.e. the very binary running this test) over a generated loader script, which is
# a faithful, deterministic stand-in for the original "two independent KiritoVM" C++ scenario. All
# error cases are runtime, folded inline via try/catch. Runs identically with `ki` and `ki --no-inline`
# (the spawned child always runs with default inlining, which does not affect the value under test).
var io = import("io")
var d = import("dump")
var path = import("path")

# scalars
io.print(d.loads(d.dumps(None)))
io.print(d.loads(d.dumps(True)))
io.print(d.loads(d.dumps(False)))
io.print(d.loads(d.dumps(42)))
io.print(d.loads(d.dumps(-1000000)))
io.print(d.loads(d.dumps(3.14159265358979)))
io.print(d.loads(d.dumps("hello world")))
# binary-safe strings (embedded NUL and high bytes)
var embeddedNul = Function():
    var s = "a\x00b"
    return len(d.loads(d.dumps(s)))
io.print(embeddedNul())

# containers
io.print(d.loads(d.dumps([1, 2, 3])))
io.print(d.loads(d.dumps([[1, [2, 3]], 4])))
io.print(d.loads(d.dumps({1, 2, 3})).contains(2))
io.print(d.loads(d.dumps({"a": [1, 2], "b": 3}))["a"][1])

# structural equality survives the round-trip
var structuralEq = Function():
    var x = [1, [2, 3], {"k": 4}]
    return d.loads(d.dumps(x)) == x
io.print(structuralEq())

# dumps returns Bytes (the binary blob); loads accepts the Bytes (or a String of the same bytes)
io.print(type(d.dumps([1, 2, 3])))
io.print(len(d.dumps([1, 2, 3])) > 0)
var blobLoads = Function():
    var blob = d.dumps([10, 20, 30])
    return d.loads(blob)
io.print(blobLoads())
# the Bytes blob round-trips through latin-1 String and back (loads accepts either)
var blobLatin1 = Function():
    var blob = d.dumps([10, 20, 30])
    return d.loads(blob.decode("latin-1").encode("latin-1"))
io.print(blobLatin1())

# SHARED references preserved: A appears twice -> one object after load
var sharedRefAppend = Function():
    var A = [1]
    var y = d.loads(d.dumps([A, A]))
    y[0].append(2)
    return y[1]
io.print(sharedRefAppend())
var sharedRefEq = Function():
    var A = [1]
    var y = d.loads(d.dumps([A, A]))
    return y[0] == y[1]
io.print(sharedRefEq())

# CYCLES round-trip
var cyclesRoundTrip = Function():
    var c = []
    c.append(c)
    var r = d.loads(d.dumps(c))
    return r[0] == r
io.print(cyclesRoundTrip())

# save / load to a binary file
var saveLoadFile = Function():
    var f = path.gettempdir() + "/kirito_dump_test.bin"
    var data = {"name": "Kirito", "scores": [10, 20, 30], "nested": {"x": [1, 2]}}
    d.save(data, f)
    var loaded = d.load(f)
    var result = String(loaded["name"]) + ":" + String(loaded["scores"][2]) + ":" + String(loaded["nested"]["x"][0])
    discard path.remove(f)
    return result
io.print(saveLoadFile())

# A user-class instance CARRIES its class: a FRESH VM that never defined the class rebuilds it from the
# blob -- no import needed. Two independent VMs share only a temp file, so there is no hidden
# dependency on VM1's class registry (see the module docstring for why this spawns a real second `ki`
# process instead of a second in-process VM).
var crossVMInstanceCarriesClass = Function():
    var sys = import("sys")
    var tmp = path.gettempdir()
    var blobPath = path.join(tmp, "kirito_inst_carry_ki.bin")
    var loaderPath = path.join(tmp, "kirito_inst_carry_loader.ki")

    class Carry:
        var _init_ = Function(self, n):
            self.n = n
        var dbl = Function(self): return self.n * 2
    d.save(Carry(21), blobPath)

    var loaderSrc = "var d = import(\"dump\")\n"
    loaderSrc = loaderSrc + "var io2 = import(\"io\")\n"
    loaderSrc = loaderSrc + "var w = d.load(\"" + blobPath + "\")\n"
    loaderSrc = loaderSrc + "io2.print(String(w.n) + \":\" + String(w.dbl()))\n"
    var lf = io.open(loaderPath, "w")
    discard lf.write(loaderSrc)
    lf.close()

    var r = sys.createprocess([path.executable, loaderPath])
    discard path.remove(blobPath)
    discard path.remove(loaderPath)
    if r["code"] != 0:
        throw "loader process failed: " + r["stderr"]
    return r["stdout"].rstrip()
io.print(crossVMInstanceCarriesClass())

# module-level save(value, path) (symmetric with serialize.save): dumps + write in one step
var moduleSave = Function():
    var f = path.gettempdir() + "/kirito_dump_save.bin"
    d.save([1, 2, {"k": "v"}], f)
    var loaded = d.load(f)
    var result = String(loaded[2]["k"]) + ":" + String(len(loaded))
    discard path.remove(f)
    return result
io.print(moduleSave())

# a large/deep structure
var bigStructure = Function():
    var big = []
    for i in range(1000):
        big.append([i, i * i])
    var r = d.loads(d.dumps(big))
    return len(r) == 1000 and r[999][1] == 998001
io.print(bigStructure())

# hostile / corrupt inputs throw cleanly, never crash
try:
    discard d.loads("not a dump")
catch as e:
    io.print(e)
try:
    discard d.loads("")
catch as e:
    io.print(e)
try:
    discard d.loads("KDMP")               # header only, truncated
catch as e:
    io.print(e)
try:                                       # a native/built-in function is not serializable (a
    discard d.dumps(len)                    # Kirito-defined Function now IS -- see below)
catch as e:
    io.print(e)
try:
    discard d.load("/nonexistent/path/xyz.bin")
catch as e:
    io.print(e)

# Kirito functions serialize by default: a plain function, a closure (captured value travels by
# value), and self-recursion (the function references itself) all round-trip through the binary
var funcPlain = Function():
    var sq = Function(x): return x * x
    return d.loads(d.dumps(sq))(9)
io.print(funcPlain())
var funcClosure = Function():
    var base = 100
    var add = Function(x): return x + base
    return d.loads(d.dumps(add))(5)
io.print(funcClosure())
var funcRecursive = Function():
    var fib = Function(n): return n if n < 2 else fib(n-1) + fib(n-2)
    return d.loads(d.dumps(fib))(10)
io.print(funcRecursive())
# A class round-trips, and so does an instance -- carrying its class, so no import is needed
var classRoundTrip = Function():
    class Pt:
        var _init_ = Function(self, x, y):
            self.x = x
            self.y = y
        var norm2 = Function(self): return self.x*self.x + self.y*self.y
    return d.loads(d.dumps(Pt))(x=3, y=4).norm2()
io.print(classRoundTrip())
var instanceRoundTrip = Function():
    class Pt2:
        var _init_ = Function(self, v): self.v = v
        var twice = Function(self): return self.v * 2
    return d.loads(d.dumps(Pt2(21))).twice()
io.print(instanceRoundTrip())

# the binary blob is now Bytes -- itself a serializable value, so it round-trips through dump (unlike
# the old opaque Dump type, which couldn't be re-dumped)
var blobReDump = Function():
    var blob = d.dumps([1, 2, 3])
    return d.loads(d.dumps(blob)) == blob
io.print(blobReDump())
