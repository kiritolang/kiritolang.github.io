# spec_slice_audit.ki — regressions from the v1.17.1 slicing deep audit.
#   F1: a Series slice-assign must NOT desync values from index (length must match).
#   F2: a list extended-slice assign with a near-INT64 step must not overflow (UBSan-clean here).
#   F3: a tensor slice-assign with a near-INT64 step must not overflow and must select correctly.
# Runs under the asan/UBSan preset, so a signed-overflow regression fails this test.

var io = import("io")
var tb = import("tabular")
var tn = import("tensor")

var BIG = 9223372036854775807      # INT64_MAX

var throwsMsg = Function(f, needle):
    try:
        discard f()
        return False
    catch String as e:
        return needle in e

# --- F1: Series slice-assign keeps values and index the same length --------------------------
var s = tb.Series([1, 2, 3, 4, 5])
s[1:3] = [20, 30]                                      # same length as the 2 selected positions -> ok
assert s.tolist() == [1, 20, 30, 4, 5], "Series same-length slice-assign replaces in place"
assert len(s.values) == len(s.index), "Series slice-assign keeps values/index aligned"
# a length-CHANGING slice-assign is refused (used to silently grow values and desync the index)
var desync = Function():
    var s2 = tb.Series([1, 2, 3, 4, 5])
    s2[1:3] = [20, 30, 40, 50]
    return s2
assert throwsMsg(desync, "selected positions"), "Series length-changing slice-assign throws"

# --- F2: list extended-slice assign with a huge step selects exactly one, no overflow --------
var a = [1, 2, 3, 4, 5, 6, 7, 8]
a[2:8:BIG] = [99]                                      # step huge -> exactly one position (index 2)
assert a == [1, 2, 99, 4, 5, 6, 7, 8], "huge-step extended assign selects one element"
var mism = Function():
    var b = [1, 2, 3, 4, 5, 6, 7, 8]
    b[2:8:BIG] = [99, 100]
    return b
assert throwsMsg(mism, "size mismatch"), "huge-step extended assign length mismatch throws"

# --- F3: tensor slice-assign with a huge step selects exactly one, no overflow ----------------
var v = tn.arange(0, 8)
v[2:8:BIG] = 9.0
assert v.tolist() == [0, 1, 9, 3, 4, 5, 6, 7], "huge-step tensor slice-assign selects one element"

io.print("spec_slice_audit: ok")
