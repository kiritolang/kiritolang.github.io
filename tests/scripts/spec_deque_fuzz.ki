# Hardening: randomized differential of the half-steal deque against a plain-list reference model
# (deterministic seed). Every op and the full contents are cross-checked, exercising the rebalance
# under arbitrary interleavings of both-end push/pop — the case the O(n^2) bug and the rewrite touch.
var collections = import("collections")
var random = import("random")
var io = import("io")
var rng = random.Random(0xC0FFEE)
var contents = Function(dq):
    var out = []
    for x in dq:
        out.append(x)
    return out
var d = collections.deque()
var model = []
for step in range(6000):
    var op = rng.randint(0, 3)
    if op == 0:
        var v = rng.randint(0, 999999)
        d.append(v)
        model.append(v)
    elif op == 1:
        var v = rng.randint(0, 999999)
        d.appendleft(v)
        model = [v] + model
    elif op == 2:
        if len(model) > 0:
            assert d.popleft() == model[0], "popleft mismatch @ " + String(step)
            model = model[1:]
    else:
        if len(model) > 0:
            assert d.pop() == model[len(model) - 1], "pop mismatch @ " + String(step)
            model = model[:len(model) - 1]
    assert len(d) == len(model), "len mismatch @ " + String(step)
    if step % 400 == 0:
        assert contents(d) == model, "contents mismatch @ " + String(step)
assert contents(d) == model, "final contents mismatch"
io.print("OK deque fuzz")
