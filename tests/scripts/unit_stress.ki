# Stress / adversarial / edge-case suite (converted from tests/unit/test_stress.cpp — the pure
# run-a-script-check-a-value cases). Locks in fixes for a class of "optional argument silently
# ignored" string-method bugs, List `*` repetition, and the format `#` alternate form — and pins
# down robustness on cycles, overflow, NaN, switch type-matching, closures, and named-argument
# binding. Runs identically with `ki` and `ki --no-inline`.
var io = import("io")

# ===== string methods must honor their optional arguments (regressions) =====
# strip(chars)
io.print("xxabcxx".strip("x"))
io.print("xyabcyx".strip("xy"))
io.print("xxabc".lstrip("x"))
io.print("abcxx".rstrip("x"))
io.print("  abc  ".strip())
# split(sep, maxsplit) and split(None, maxsplit)
io.print(",".join("a,b,c".split(",", 1)))
io.print(String(len("a,b,c".split(",", 1))))
io.print("a,b,c".split(",", 1)[1])
io.print("a b c d".split(None, 1)[1])
io.print(String(len("a,b,c".split(",", 0))))
# replace(old, new, count)
io.print("aaaa".replace("a", "b", 2))
io.print("aaaa".replace("a", "b"))
io.print("aaaa".replace("a", "b", 0))
# find / index / rfind / rindex with start[, end]
io.print(String("abcabc".find("a", 1)))
io.print(String("abcabc".find("bc", 0, 3)))
io.print(String("abcabc".find("c", 0, 2)))
io.print(String("abcabc".rfind("a", 0, 3)))
io.print(String("abcabc".index("b", 2)))
var indexoob = Function():
    try:
        discard "abcabc".index("a", 4)
        return "no-throw"
    catch as e:
        return e
io.print(indexoob())
# count with [start, end]
io.print(String("abcabc".count("a", 1)))
io.print(String("aaaa".count("a", 1, 3)))
# startswith / endswith with [start, end]
io.print(String("abcabc".startswith("bc", 1)))
io.print(String("abcabc".startswith("ab", 1)))
io.print(String("abcabc".endswith("bc", 0, 3)))
io.print(String("abcabc".endswith("ab", 0, 3)))
# unicode: start is a code-point index, not a byte offset
io.print(String("héllo héllo".find("llo", 5)))

# ===== List `*` repetition (regression: was unimplemented) =====
io.print([1, 2] * 3)
io.print(3 * [1, 2])
io.print([1, 2] * 0)
io.print([1, 2] * -3)
# repetition shares element handles
var listmulshare = Function():
    var x = [[0]] * 3
    x[0].append(9)
    return String(x)
io.print(listmulshare())
# guarded against absurd counts
var listmulhuge = Function():
    try:
        discard [0] * 100000000000
        return "no-throw"
    catch as e:
        return e
io.print(listmulhuge())

# ===== format `#` alternate form (regression: was parsed but ignored) =====
io.print(format(255, "#x"))
io.print(format(255, "#X"))
io.print(format(8, "#o"))
io.print(format(5, "#b"))
io.print(format(255, "#08x"))
io.print(format(-255, "#x"))
io.print(format(255, "x"))

# ===== integer overflow: defined wraparound, never UB/crash =====
var MIN = -9223372036854775807 - 1
io.print(String(MIN // -1))  # wraps, no crash
io.print(String(MIN % -1))
io.print(String(-MIN))
io.print(String(abs(MIN)))

# ===== NaN / float key semantics (internally consistent, equality-based) =====
var nan = import("math").nan
io.print(String(nan == nan))
io.print(String(nan < 1 or nan > 1))
# Integer and Float that compare equal collapse to one dict key
var dictintfloat = Function():
    var d = {}
    d[1] = "i"
    d[1.0] = "f"
    return String(len(d))
io.print(dictintfloat())
# 0.0 and -0.0 are the same key
var dictzero = Function():
    var d = {}
    d[0.0] = 1
    d[-1.0 * 0.0] = 2
    return String(len(d))
io.print(dictzero())

# ===== cyclic structures must terminate (str / == / in) =====
var cycstr = Function():
    var a = [1, 2]
    a.append(a)
    return String(a)
io.print(cycstr())
var cyceq = Function():
    var a = []
    a.append(a)
    return String(a == a)
io.print(cyceq())
var cycdict = Function():
    var d = {}
    d["k"] = d
    return String(d)
io.print(cycdict())

# ===== switch: exact type matching, single subject evaluation =====
var f = Function(x):
    switch x:
        case 1:
            return "int"
        case True:
            return "bool"
        case 1.0:
            return "float"
        default:
            return "other"
io.print(f(1))
io.print(f(True))
io.print(f(1.0))
io.print(f(2))
# subject evaluated exactly once (top-level: g mutates the global n — a nested closure cannot
# write through to an enclosing function's local, so this must not be wrapped in a Function)
var n = 0
var g2 = Function():
    n = n + 1
    return 2
switch g2():
    case 2:
        pass
io.print(String(n))

# ===== closures: late binding of loop var; independent instances =====
var latebinding = Function():
    var fns = []
    for i in range(3):
        fns.append(Function(): return i)
    return String([fns[0](), fns[1](), fns[2]()])
io.print(latebinding())
var indepclosures = Function():
    var make = Function(n): return Function(): return n
    return String([make(10)(), make(20)()])
io.print(indepclosures())

# ===== named-argument binding error paths (Kirito + native) =====
var g = Function(a, b): return a - b
io.print(String(g(b=3, a=10)))
var gmultival = Function():
    try:
        discard g(10, a=1)
        return "no-throw"
    catch as e:
        return e
io.print(gmultival())
var gtoomanypos = Function():
    try:
        discard g(1, 2, 3)
        return "no-throw"
    catch as e:
        return e
io.print(gtoomanypos())
var gmissing = Function():
    try:
        discard g(1)
        return "no-throw"
    catch as e:
        return e
io.print(gmissing())
var roundbogus = Function():
    try:
        discard round(1, bogus=2)
        return "no-throw"
    catch as e:
        return e
io.print(roundbogus())

# ===== List.index honors the optional [start[, end]] window =====
io.print(String([1, 2, 1, 2].index(1, 1)))
io.print(String([1, 2, 1, 2].index(2, 2)))
io.print(String([1, 2, 1, 2].index(2, -2)))
var indexwindow = Function():
    try:
        discard [1, 2, 1, 2].index(1, 1, 2)
        return "no-throw"
    catch as e:
        return e
io.print(indexwindow())

# ===== collections respect a user class's _eq_ (in / index / count / remove) =====
class P:
    var _init_ = Function(self, v):
        self.v = v
    var _eq_ = Function(self, o):
        return self.v == o.v
io.print(String(P(1) == P(1)))
io.print(String(P(1) in [P(2), P(1)]))
io.print(String(P(9) in [P(2), P(1)]))
io.print(String([P(2), P(1)].index(P(1))))
io.print(String([P(1), P(1), P(2)].count(P(1))))
var removeeq = Function():
    var L = [P(1), P(2), P(1)]
    L.remove(P(1))
    return String(len(L))
io.print(removeeq())

# ===== sorted / min / max / < respect a user class's _lt_ =====
class P:
    var _init_ = Function(self, v):
        self.v = v
    var _lt_ = Function(self, o):
        return self.v < o.v
    var _str_ = Function(self):
        return "P" + String(self.v)
io.print(String(sorted([P(3), P(1), P(2)])))
io.print(String(min([P(3), P(1), P(2)])))
io.print(String(max([P(3), P(1), P(2)])))
io.print(String(P(1) < P(2)))
io.print(String(sorted([P(3), P(1), P(2)], reverse=True)))

# ===== resource guards: bounded, throw instead of OOM =====
var strmulhuge = Function():
    try:
        discard "x" * 100000000000
        return "no-throw"
    catch as e:
        return e
io.print(strmulhuge())
var rangehuge = Function():
    try:
        discard len(range(100000000000))
        return "no-throw"
    catch as e:
        return e
io.print(rangehuge())
io.print("x" * -5)
